<Application x:Class="Parking.UI.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Parking.UI.Windows"
             xmlns:vm="clr-namespace:Parking.UI.Windows.ViewModels"
             xmlns:views="clr-namespace:Parking.UI.Windows.View.Pages">

    <Application.Resources>

        <!-- PLACAS -->
        <DataTemplate DataType="{x:Type vm:PlateReaderViewModel}">
            <views:PlateReaderPage/>
        </DataTemplate>

        <!-- TIPOS VEHÍCULO -->
        <DataTemplate DataType="{x:Type vm:vehicle_typeViewModel}">
            <views:vehicle_typePage/>
        </DataTemplate>

        <!-- USUARIOS -->
        <DataTemplate DataType="{x:Type vm:userViewModel}">
            <views:userPage/>
        </DataTemplate>

        <!-- CLIENTES -->
        <DataTemplate DataType="{x:Type vm:RegisteredVehicleViewModel}">
            <views:RegisteredVehiclePage/>
        </DataTemplate>

        <!-- CONFIGURACIONES -->
        <DataTemplate DataType="{x:Type vm:ParkingSlotViewModel}">
            <views:ParkingSlotPage/>
        </DataTemplate>

        <!-- DASHOBOARD -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage/>
        </DataTemplate>

        <!-- CAJA -->
        <DataTemplate DataType="{x:Type vm:CashViewModel}">
            <views:CashPage/>
        </DataTemplate>
        
        <!-- REPORTE OPERADORES -->
        <DataTemplate DataType="{x:Type vm:OperatorReportViewModel}">
            <views:OperatorReportPage/>
        </DataTemplate>

    </Application.Resources>

</Application>