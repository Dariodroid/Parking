<Window x:Class="Parking.UI.Windows.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Parking.UI.Windows.ViewModels"
        xmlns:views="clr-namespace:Parking.UI.Windows.View.Pages"
        xmlns:local="clr-namespace:Parking.UI.Windows.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sistema de Parqueadero"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppPageBrush}"
        WindowStyle="None"
        ResizeMode="CanResize">

    <!-- WINDOWCHROME PERMITE REDIMENSIONAR Y ARRASTRAR SIN BORDES DE WINDOWS -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- CONVERTERS -->
        <local:EqualityConverter x:Key="EqualityConverter"/>
        <local:MenuWidthConverter x:Key="MenuWidthConverter"/>
        <local:DoubleToVisibilityConverter x:Key="DoubleToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="RoleVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="LoadingVisibilityConverter"/>

        <!-- VISTAS -->
        <DataTemplate DataType="{x:Type vm:PlateReaderViewModel}">
            <views:PlateReaderPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VehicleTypeViewModel}">
            <views:VehicleTypePage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UserViewModel}">
            <views:UserPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OperationsControlViewModel}">
            <views:OperationsControlPage/>
        </DataTemplate>

        <!-- ESTILO MENÚ MODERNO -->
        <Style x:Key="ModernMenuButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <!-- EFECTO AL PASAR EL MOUSE -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                </Trigger>

                <!-- EFECTO AL ESTAR SELECCIONADO (PÁGINA ACTUAL) -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                            <Binding Path="CurrentMenuKey" />
                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILOS DE BOTONES DE LA BARRA DE TÍTULO -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AppRaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <!-- BARRA DE TÍTULO -->
            <RowDefinition Height="*"/>
            <!-- CONTENIDO -->
        </Grid.RowDefinitions>

        <!-- BARRA DE TÍTULO PERSONALIZADA -->
        <Border Grid.Row="0" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <materialDesign:PackIcon Kind="CarOutline" Width="18" Height="18" Foreground="{DynamicResource AppAccentTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Sistema de Parqueadero" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="46" Height="38" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16" Foreground="{DynamicResource AppMutedTextBrush}"/>
                    </Button>
                    <Button Width="46" Height="38" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click">
                        <materialDesign:PackIcon Kind="WindowMaximize" Width="16" Height="16" Foreground="{DynamicResource AppMutedTextBrush}"/>
                    </Button>
                    <Button Width="46" Height="38" Style="{StaticResource CloseTitleBarButtonStyle}" Click="CloseButton_Click">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource AppMutedTextBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ÁREA PRINCIPAL (SIDEBAR + CONTENIDO) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Width>
                        <MultiBinding Converter="{StaticResource MenuWidthConverter}">
                            <Binding ElementName="MenuToggle" Path="IsChecked"/>
                            <Binding ElementName="ExpanderReportes" Path="IsExpanded"/>
                            <Binding ElementName="ExpanderConfig" Path="IsExpanded"/>
                        </MultiBinding>
                    </ColumnDefinition.Width>
                </ColumnDefinition>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Grid x:Name="SidebarGrid" Background="{DynamicResource AppSidebarBrush}" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- LOGO Y BOTÓN HAMBURGUESA -->
                <StackPanel Orientation="Horizontal" Margin="15,20,15,20">
                    <ToggleButton x:Name="MenuToggle" IsChecked="True" Click="MenuToggle_Click"
                                  Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                  Margin="0,0,15,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" Padding="5">
                                    <ContentPresenter Content="{TemplateBinding Content}"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <materialDesign:PackIcon Kind="Menu" Width="28" Height="28" Foreground="{DynamicResource AppMutedTextBrush}"/>
                    </ToggleButton>

                    <TextBlock Text="PARKING"
                               Foreground="{DynamicResource AppAccentTextBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                </StackPanel>

                <!-- MENÚ CON SCROLL -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,20">

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Style="{StaticResource ModernMenuButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Operaciones" Style="{StaticResource ModernMenuButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CarOutline" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Operaciones" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Caja" Style="{StaticResource ModernMenuButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Caja" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Centro de control" Style="{StaticResource ModernMenuButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ShieldCheck" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Centro de control" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Clientes" Style="{StaticResource ModernMenuButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Clientes" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Usuarios" Style="{StaticResource ModernMenuButtonStyle}"
                                Visibility="{Binding CanManageSystem, Converter={StaticResource RoleVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountCircle" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Usuarios" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>

                        <!-- EXPANDER REPORTES -->
                        <Expander x:Name="ExpanderReportes" Foreground="{DynamicResource AppMutedTextBrush}" Background="Transparent" Margin="8,3" Padding="15,10" FontSize="14"
                                  Visibility="{Binding CanManageSystem, Converter={StaticResource RoleVisibilityConverter}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="-10,0,0,0">
                                    <materialDesign:PackIcon Kind="ChartBar" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reportes" VerticalAlignment="Center" Margin="15,0,0,0"
                                               Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Margin="15,5,0,5">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Reporte Operadores" Style="{StaticResource ModernMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountTie" Width="24" Height="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Operadores" VerticalAlignment="Center" Margin="15,0,0,0"
                                                   Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Reporte Vehiculos" Style="{StaticResource ModernMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CarMultiple" Width="24" Height="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Vehículos" VerticalAlignment="Center" Margin="15,0,0,0"
                                                   Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Reporte Rendimiento" Style="{StaticResource ModernMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ChartLine" Width="24" Height="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Rendimiento" VerticalAlignment="Center" Margin="15,0,0,0"
                                                   Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="ExpanderConfig" Foreground="{DynamicResource AppMutedTextBrush}" Background="Transparent" Margin="8,3" Padding="15,10" FontSize="14">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="-10,0,0,0">
                                    <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Configuración" VerticalAlignment="Center" Margin="15,0,0,0"
                                               Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Margin="15,5,0,5">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Config" Style="{StaticResource ModernMenuButtonStyle}"
                                        Visibility="{Binding CanManageSystem, Converter={StaticResource RoleVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Parking" Width="24" Height="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Puestos" VerticalAlignment="Center" Margin="15,0,0,0"
                                                   Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Tipos Vehículo" Style="{StaticResource ModernMenuButtonStyle}"
                                        Visibility="{Binding CanManageSystem, Converter={StaticResource RoleVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CarInfo" Width="24" Height="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tipos Vehículo" VerticalAlignment="Center" Margin="15,0,0,0"
                                                   Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Apariencia y conexión" Style="{StaticResource ModernMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ThemeLightDark" Width="24" Height="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Preferencias" VerticalAlignment="Center" Margin="15,0,0,0"
                                                   Visibility="{Binding ElementName=SidebarGrid, Path=ActualWidth, Converter={StaticResource DoubleToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- CONTENIDO PRINCIPAL -->
            <Grid Grid.Column="1" Background="{DynamicResource AppPageBrush}">
                <!-- La vista ocupa la altura disponible; así su pie fijo puede
                     reservar espacio sin quedar fuera del área visible. -->
                <ContentControl Content="{Binding CurrentView}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Grid>
        </Grid>
        <!-- La animación cubre toda la ventana y deja ver Operaciones detrás. -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="11"
              Visibility="{Binding IsModernLoading, Converter={StaticResource LoadingVisibilityConverter}}">
            <Border Background="#99000000"/>
            <Border Width="480" Padding="30,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentTextBrush}"
                    BorderThickness="1" CornerRadius="14">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="PARKING  /  SISTEMA DE CAPTURA" Foreground="{DynamicResource AppAccentTextBrush}"
                                FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                    <Grid Width="176" Height="176" HorizontalAlignment="Center" Margin="0,22,0,14">
                        <Ellipse Width="164" Height="164" Stroke="{DynamicResource AppAccentTextBrush}" StrokeThickness="4"
                                 StrokeDashArray="9 6" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModernLoading}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="OuterLoadingSpin">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:2.2" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="OuterLoadingSpin"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="126" Height="126" Stroke="{DynamicResource AppInputBorderBrush}" StrokeThickness="7"
                                 StrokeDashArray="2 5" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModernLoading}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="InnerLoadingSpin">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="360" To="0" Duration="0:0:1.6" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="InnerLoadingSpin"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="82" Height="82" Fill="{DynamicResource AppSelectedBrush}"
                                 Stroke="{DynamicResource AppAccentTextBrush}" StrokeThickness="1"/>
                        <materialDesign:PackIcon Kind="CarOutline" Width="43" Height="43"
                                                 Foreground="{DynamicResource AppAccentTextBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding LoadingTitle}" FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextBrush}" TextAlignment="Center"/>
                    <TextBlock Text="{Binding LoadingDetail}" FontSize="12" TextWrapping="Wrap"
                               Width="360" Foreground="{DynamicResource AppMutedTextBrush}"
                               TextAlignment="Center" Margin="0,9,0,18"/>
                    <!-- Un haz cruza la barra sin simular un porcentaje que el driver no ofrece. -->
                    <Canvas Width="350" Height="6" Background="{DynamicResource AppRaisedBrush}" ClipToBounds="True">
                        <Rectangle Width="120" Height="6" Canvas.Left="-120"
                                   Fill="{DynamicResource AppAccentTextBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModernLoading}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="LoadingBarMotion">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)"
                                                                         From="-120" To="350" Duration="0:0:1.65"
                                                                         RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="LoadingBarMotion"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Canvas>
                    <TextBlock Text="SISTEMA EN PREPARACIÓN" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               TextAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
