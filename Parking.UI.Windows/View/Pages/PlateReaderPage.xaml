<UserControl x:Class="Parking.UI.Windows.View.Pages.PlateReaderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Parking.UI.Windows.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource AppPageBrush}"
             d:DesignHeight="720" d:DesignWidth="1280"
             SizeChanged="PlateReaderPage_SizeChanged">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:EqualityConverter x:Key="EqualityConverter"/>
        <local:VehicleNameToIconConverter x:Key="VehicleNameToIconConverter"/>

        <!-- La selección de cámaras usa los colores activos del tema. -->
        <Style x:Key="CameraSourceItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1769A8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1769A8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CameraSourceStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CameraSourceItemStyle}"/>
            <!-- La plantilla conserva el nombre legible y usa el fondo del tema. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- El botón ocupa todo el selector para abrirlo desde cualquier punto. -->
                            <ToggleButton Style="{x:Null}" Focusable="False" ClickMode="Press"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppInputBorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18"
                                                                     Foreground="{DynamicResource AppTextBrush}" HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- La lista contiene CameraSource; mostramos su nombre legible, no el record completo. -->
                            <TextBlock IsHitTestVisible="False" Margin="9,0,32,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppInputBorderBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Los cuatro medios muestran inmediatamente cuál se usará en la próxima salida. -->
        <Style x:Key="PaymentMethodButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppSidebarBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentTextBrush}"/>
                </Trigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="DataContext.SelectedPaymentMethod" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="#00BFFF"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CameraUrlStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}"/>
        </Style>
        <Style x:Key="CameraControlButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1769A8"/>
            <Setter Property="BorderBrush" Value="#459ACB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>

        <!-- ESPACIOS REDUCIDOS PARA EVITAR SCROLL -->
        <Style x:Key="SidebarSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA: TARJETAS Y DOS FUENTES INDEPENDIENTES -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TARJETAS INFORMATIVAS -->
            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">

                <!-- TOTAL -->
                <Border Margin="5" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15,10">
                    <StackPanel>
                        <TextBlock Text="TOTAL DE PUESTOS" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalSlots}" Foreground="{DynamicResource AppTextBrush}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- OCUPADOS -->
                <Border Margin="5" Background="#B71C1C" CornerRadius="8" Padding="15,10">
                    <StackPanel>
                        <TextBlock Text="PUESTOS OCUPADOS" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OccupiedSlots}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- LIBRES -->
                <Border Margin="5" Background="#1B5E20" CornerRadius="8" Padding="15,10">
                    <StackPanel>
                        <TextBlock Text="PUESTOS LIBRES" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FreeSlots}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Cada panel tiene su fuente y su imagen; ambos pueden reconocer placas y QR. -->
            <Grid x:Name="CameraLayoutGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <!-- Cámara orientada a la entrada de vehículos. -->
                <Border x:Name="EntranceCameraPanel" Grid.Column="0" DataContext="{Binding EntranceFeed}" Margin="0,0,5,0"
                        Background="{DynamicResource AppCameraPanelBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="10,8">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AppAccentTextBrush}" FontWeight="Bold"/>
                            <ComboBox Style="{StaticResource CameraSourceStyle}" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" Height="30" Margin="0,5,0,0"/>
                            <TextBox Style="{StaticResource CameraUrlStyle}" Text="{Binding NetworkUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsNetworkSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                     ToolTip="URL de vídeo RTSP/HTTP; en el perfil DroidCam también se admite solo la IP" Margin="0,5,0,0" Height="30"/>
                            <TextBlock Text="Introduzca la URL completa del vídeo RTSP/HTTP de la cámara IP o ANPR."
                                       Visibility="{Binding IsGenericNetworkSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="DroidCam: escriba IP o IP:puerto; se añade /video automáticamente."
                                       Visibility="{Binding IsDroidCamSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,5,0,0"/>
                            <!-- Los controles de Entrada actúan solo sobre este panel. -->
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Style="{StaticResource CameraControlButtonStyle}" Content="Iniciar entrada" Margin="0,0,7,0"
                                        Command="{Binding DataContext.StartFeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource CameraControlButtonStyle}" Content="Detener entrada"
                                        Command="{Binding DataContext.StopFeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1" Background="Black">
                            <TextBlock Text="Sin imagen de entrada" Foreground="{DynamicResource AppTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Preview}" Stretch="Uniform"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Cámara orientada a la salida; también admite placa o QR. -->
                <Border x:Name="ExitCameraPanel" Grid.Column="1" DataContext="{Binding ExitFeed}" Margin="5,0,0,0"
                        Background="{DynamicResource AppCameraPanelBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="10,8">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AppAccentTextBrush}" FontWeight="Bold"/>
                            <ComboBox Style="{StaticResource CameraSourceStyle}" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" Height="30" Margin="0,5,0,0"/>
                            <TextBox Style="{StaticResource CameraUrlStyle}" Text="{Binding NetworkUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsNetworkSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                     ToolTip="URL de vídeo RTSP/HTTP; en el perfil DroidCam también se admite solo la IP" Margin="0,5,0,0" Height="30"/>
                            <TextBlock Text="Introduzca la URL completa del vídeo RTSP/HTTP de la cámara IP o ANPR."
                                       Visibility="{Binding IsGenericNetworkSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="DroidCam: escriba IP o IP:puerto; se añade /video automáticamente."
                                       Visibility="{Binding IsDroidCamSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,5,0,0"/>
                            <!-- Los controles de Salida permiten trasladar aquí una cámara liberada de Entrada. -->
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Style="{StaticResource CameraControlButtonStyle}" Content="Iniciar salida" Margin="0,0,7,0"
                                        Command="{Binding DataContext.StartFeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource CameraControlButtonStyle}" Content="Detener salida"
                                        Command="{Binding DataContext.StopFeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1" Background="Black">
                            <TextBlock Text="Sin imagen de salida" Foreground="{DynamicResource AppTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Preview}" Stretch="Uniform"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- COLUMNA DERECHA: PANEL LATERAL -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- DETECCIÓN DE PLACA -->
                <Border Style="{StaticResource SidebarSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="DETECCIÓN DE PLACA" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PlateNumber, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="8"
                                 FontSize="25" FontWeight="Bold" Height="43"
                                 ToolTip="Escriba letras y números; el guion se agrega solo."
                                 Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                                 BorderBrush="{DynamicResource AppInputBorderBrush}" BorderThickness="1"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource AppTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- RESUMEN DE COBRO -->
                <Border Style="{StaticResource SidebarSectionStyle}" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
                    <StackPanel>
                        <TextBlock Text="RESUMEN DE COBRO" Foreground="#4A90E2" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Viewbox Height="33">
                            <TextBlock Text="{Binding AmountToCharge, Converter={StaticResource CurrencyConverter}}"
                                       FontWeight="Black" Foreground="{DynamicResource AppTextBrush}" />
                        </Viewbox>
                        <TextBlock Text="MEDIO DE PAGO · PRÓXIMA SALIDA"
                                   Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11"
                                   FontWeight="SemiBold" Margin="0,6,0,3"/>
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource PaymentMethodButtonStyle}" Command="{Binding SelectPaymentMethodCommand}"
                                    CommandParameter="cash" ToolTip="Efectivo">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CashMultiple" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="Efectivo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PaymentMethodButtonStyle}" Command="{Binding SelectPaymentMethodCommand}"
                                    CommandParameter="transfer" ToolTip="Transferencia">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Bank" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="Transfer." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PaymentMethodButtonStyle}" Command="{Binding SelectPaymentMethodCommand}"
                                    CommandParameter="card" ToolTip="Tarjeta">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CreditCard" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="Tarjeta" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PaymentMethodButtonStyle}" Command="{Binding SelectPaymentMethodCommand}"
                                    CommandParameter="other" ToolTip="Otro medio o sin especificar">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="DotsHorizontal" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="Otro" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- TIPO DE VEHÍCULO Y ACCIONES -->
                <Border Style="{StaticResource SidebarSectionStyle}">
                    <StackPanel>

                        <TextBlock Text="TIPO DE VEHÍCULO" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>

                        <ItemsControl ItemsSource="{Binding VehicleTypes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="2"
                                            Height="58"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.SelectVehicleTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">

                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="cardBorder" CornerRadius="8" BorderThickness="2" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
                                                    <ContentPresenter Content="{TemplateBinding Content}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="#4FC3F7"/>
                                                        <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
                                                    </Trigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Value="True">
                                                                <Condition.Binding>
                                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                        <Binding />
                                                                        <Binding Path="DataContext.SelectedVehicleType" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                    </MultiBinding>
                                                                </Condition.Binding>
                                                            </Condition>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="#00BFFF"/>
                                                        <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource AppSelectedBrush}"/>
                                                    </MultiDataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="{Binding name, Converter={StaticResource VehicleNameToIconConverter}}"
                                                                     Width="20"
                                                                     Height="20"
                                                                     Foreground="{DynamicResource AppAccentTextBrush}"
                                                                     HorizontalAlignment="Center"/>
                                            <TextBlock Margin="0,1,0,0"
                                                       Text="{Binding name}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppTextBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Margin="0,0,0,0"
                                                       Text="{Binding hourly_rate, Converter={StaticResource CurrencyConverter}, ConverterParameter=/h}"
                                                       FontSize="10"
                                                       Foreground="#81C784"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="PUESTO LIBRE (OPCIONAL)" Foreground="{DynamicResource AppMutedTextBrush}"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,7,0,4"/>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding AvailableSlots}"
                                      SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                                      DisplayMemberPath="slot_number"
                                      ToolTip="Sin elegir un puesto, se asigna automáticamente."
                                      Height="36" VerticalContentAlignment="Center"
                                      Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                                      BorderBrush="{DynamicResource AppInputBorderBrush}"/>
                            <Button Grid.Column="1" Content="Automático"
                                    Command="{Binding UseAutomaticSlotCommand}"
                                    Margin="8,0,0,0" Padding="10,4"
                                    Background="{DynamicResource AppRaisedBrush}" Foreground="{DynamicResource AppTextBrush}"
                                    BorderBrush="{DynamicResource AppInputBorderBrush}" Cursor="Hand"/>
                        </Grid>
                        <!-- BOTÓN REGISTRAR ENTRADA CON ICONO -->
                        <Button Command="{Binding SavePlateCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#2E7D32" Foreground="White">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Login" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="REGISTRAR ENTRADA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- BOTÓN REGISTRAR SALIDA CON ICONO -->
                        <Button Command="{Binding RegisterExitCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#C62828" Foreground="White"
                                Margin="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="REGISTRAR SALIDA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ReprintLastTicketCommand}"
                                IsEnabled="{Binding CanReprintLastTicket}"
                                Background="{DynamicResource AppRaisedBrush}"
                                Foreground="{DynamicResource AppTextBrush}"
                                BorderBrush="{DynamicResource AppInputBorderBrush}"
                                Height="38" Margin="0,7,0,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,7,0"/>
                                <TextBlock Text="REIMPRIMIR ÚLTIMO TICKET" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- RESULTADO DE LA OPERACIÓN -->
                <Border Style="{StaticResource SidebarSectionStyle}" MinHeight="48">
                    <StackPanel>
                        <TextBlock Text="ESTADO DE OPERACIÓN" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12"
                                   TextWrapping="Wrap" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- Las fuentes se inician solo al pulsar el control del visor correspondiente. -->
                <Grid Margin="0,2,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- BOTÓN INICIAR CÁMARA CON ICONO -->
                    <Button Command="{Binding StartCameraCommand}"
                            Background="{DynamicResource AppRaisedBrush}" Foreground="{DynamicResource AppTextBrush}"
                            Padding="5" Margin="0,0,5,0" FontSize="12"
                            BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Video" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Iniciar ambas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- El control lateral cierra las dos capturas. -->
                    <Button Grid.Column="1"
                            Command="{Binding StopCameraCommand}"
                            Background="{DynamicResource AppRaisedBrush}" Foreground="{DynamicResource AppTextBrush}"
                            Padding="5" Margin="5,0,5,0" FontSize="12"
                            BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="VideoOff" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Detener ambas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Permite descubrir una webcam conectada después de abrir la pantalla. -->
                    <Button Grid.Column="2" Command="{Binding RefreshCamerasCommand}"
                            Background="{DynamicResource AppRaisedBrush}" Foreground="{DynamicResource AppTextBrush}"
                            Padding="5" Margin="5,0,0,0" FontSize="12"
                            BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Buscar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Versión original: se conserva completa para recuperarla desde UseClassicLoading. -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="10"
              Visibility="{Binding IsClassicLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource AppPageBrush}" Opacity="0.94"/>
            <Border Width="360" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="16">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="82" Height="82" HorizontalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource AppAccentTextBrush}" StrokeThickness="5"
                                 StrokeDashArray="5 3" StrokeDashCap="Round">
                            <Ellipse.RenderTransform>
                                <RotateTransform CenterX="41" CenterY="41"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClassicLoading}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="LoadingRotation">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:1.4" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="LoadingRotation"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <materialDesign:PackIcon Kind="CarOutline" Width="34" Height="34"
                                                 Foreground="{DynamicResource AppAccentTextBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding LoadingTitle}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextBrush}" TextAlignment="Center" Margin="0,22,0,8"/>
                    <TextBlock Text="{Binding LoadingDetail}" FontSize="12"
                               Foreground="{DynamicResource AppMutedTextBrush}" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
