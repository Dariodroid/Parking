<UserControl x:Class="Parking.UI.Windows.View.Pages.PlateReaderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             Background="#121212"
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="SidebarSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#000000" Margin="10,10,5,10" CornerRadius="4" BorderBrush="#2A2A2A" BorderThickness="1">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsCameraRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
                    <TextBlock Text="CÁMARA DESACTIVADA" Foreground="#555555" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Inicie el visor desde el panel lateral" Foreground="#333333" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>

                <Image Source="{Binding CameraPreview}" Stretch="Uniform" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5,10,10,10">

                <Border Style="{StaticResource SidebarSectionStyle}">
                    <StackPanel>
                        <TextBlock Text="DETECCIÓN DE PLACA" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding PlateNumber, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="32" FontWeight="Bold" Height="60"
                                 Background="#0A0A0A" Foreground="#FFFFFF" 
                                 BorderBrush="#444444" BorderThickness="1"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Edite manualmente si es necesario" Foreground="#555555" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SidebarSectionStyle}" Background="#151A20" BorderBrush="#2D4A63">
                    <StackPanel>
                        <TextBlock Text="RESUMEN DE COBRO" Foreground="#4A90E2" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Viewbox Height="60">
                            <TextBlock Text="{Binding AmountToCharge, StringFormat={}{0:C2}}" 
                                       FontWeight="Black" Foreground="#FFFFFF" />
                        </Viewbox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SidebarSectionStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource SidebarSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="TIPO DE VEHÍCULO"
                   Foreground="#888888"
                   FontSize="11"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

                                <ComboBox ItemsSource="{Binding VehicleTypes}"
                  SelectedItem="{Binding SelectedVehicleType}"
                  Height="42"
                  FontSize="14"
                  Background="#0A0A0A"
                  Foreground="White"
                  BorderBrush="#444444"
                  BorderThickness="1"
                  Padding="8">

                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Icon}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#CCCCCC"/>

                                                <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="8,0,0,0"/>

                                                <TextBlock Grid.Column="2"
                                   Text="{Binding HourlyRate, StringFormat={}{0:C2}/h}"
                                   VerticalAlignment="Center"
                                   Foreground="#4A90E2"
                                   Margin="10,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Seleccione el tipo antes de registrar entrada"
                   Foreground="#555555"
                   FontSize="10"
                   Margin="0,5,0,0"
                   HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="REGISTRAR ENTRADA"
                                Command="{Binding SavePlateCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#2E7D32" Foreground="White"
                                Margin="0,0,0,10"/>

                        <Button Content="REGISTRAR SALIDA"
                                Command="{Binding RegisterExitCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#C62828" Foreground="White"/>                        
                    </StackPanel>                    
                </Border>

                <Border Style="{StaticResource SidebarSectionStyle}" MinHeight="100">
                    <StackPanel>
                        <TextBlock Text="LOG DEL SISTEMA" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#CCCCCC" FontSize="13" 
                                   TextWrapping="Wrap" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Iniciar Cámara" 
                            Command="{Binding StartCameraCommand}" 
                            Background="#333333" Foreground="#AAAAAA"
                            Padding="5" Margin="0,0,5,0" FontSize="12"/>
                    <Button Grid.Column="1" Content="Detener" 
                            Command="{Binding StopCameraCommand}" 
                            Background="#333333" Foreground="#AAAAAA"
                            Padding="5" Margin="5,0,0,0" FontSize="12"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>