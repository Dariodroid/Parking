<UserControl x:Class="Parking.UI.Windows.View.Pages.ParkingSlotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Parking.UI.Windows.Converters"
             mc:Ignorable="d"
             Background="#121212">

    <UserControl.Resources>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="MinWidth" Value="95"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="DarkDataGridHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO -->

        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- FORMULARIO -->

                <Border Style="{StaticResource SectionStyle}">

                    <StackPanel>

                        <TextBlock Text="PUESTO DE PARQUEO"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="CÓDIGO DEL PUESTO"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding SlotNumber,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Ejemplos: 1, 1A, A-01, MOTO-01"
                                   Foreground="#777777"
                                   FontSize="11"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="ESTADO"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,15,0,5"/>

                        <TextBlock Text="{Binding OccupancyStatus}"
                                   Foreground="#4FC3F7"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>

                <!-- BOTONES -->

                <Border Style="{StaticResource SectionStyle}">

                    <WrapPanel>

                        <Button Content="GUARDAR"
                                Command="{Binding SaveCommand}"
                                Background="#2E7D32"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="ACTUALIZAR"
                                Command="{Binding UpdateCommand}"
                                Background="#1565C0"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="NUEVO"
                                Command="{Binding NewCommand}"
                                Background="#333333"
                                Foreground="#DDDDDD"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="ELIMINAR"
                                Command="{Binding DeleteCommand}"
                                Background="#C62828"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                    </WrapPanel>

                </Border>

                <!-- ESTADO -->

                <Border Style="{StaticResource SectionStyle}">

                    <StackPanel>

                        <TextBlock Text="ESTADO"
                                   Foreground="#888888"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#CCCCCC"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- TABLA -->

        <Border Grid.Column="2"
                Background="#1A1A1A"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6">

            <DataGrid ItemsSource="{Binding Slots}"
                      SelectedItem="{Binding SelectedSlot}"
                      AutoGenerateColumns="False"
                      Background="#1A1A1A"
                      Foreground="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowBackground="#1A1A1A"
                      AlternatingRowBackground="#202020"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      ColumnHeaderStyle="{StaticResource DarkDataGridHeaderStyle}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="PUESTO"
                        Binding="{Binding slot_number}"
                        Width="220"/>

                    <DataGridTemplateColumn Header="OCUPADO"
                            Width="160">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <ToggleButton IsChecked="{Binding is_occupied}"
                              IsEnabled="False"
                              Width="70"
                              Height="30"
                              BorderThickness="0">

                                    <ToggleButton.Style>

                                        <Style TargetType="ToggleButton">

                                            <!-- LIBRE por defecto -->
                                            <Setter Property="Background"
            Value="#2E7D32"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="ToggleButton">

                                                        <Border Width="70"
                        Height="30"
                        Background="{TemplateBinding Background}"
                        CornerRadius="15">

                                                            <Grid>

                                                                <Ellipse x:Name="SwitchThumb"
                                 Width="24"
                                 Height="24"
                                 Fill="White"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0"/>

                                                                <TextBlock x:Name="SwitchText"
                                   Text="LIBRE"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,8,0"/>

                                                            </Grid>

                                                        </Border>

                                                        <ControlTemplate.Triggers>

                                                            <!-- OCUPADO -->
                                                            <Trigger Property="IsChecked"
                             Value="True">

                                                                <Setter Property="Background"
                                Value="#C62828"/>

                                                                <Setter TargetName="SwitchThumb"
                                Property="HorizontalAlignment"
                                Value="Right"/>

                                                                <Setter TargetName="SwitchThumb"
                                Property="Margin"
                                Value="0,0,3,0"/>

                                                                <Setter TargetName="SwitchText"
                                Property="Text"
                                Value="OCUPADO"/>

                                                                <Setter TargetName="SwitchText"
                                Property="HorizontalAlignment"
                                Value="Left"/>

                                                                <Setter TargetName="SwitchText"
                                Property="Margin"
                                Value="8,0,0,0"/>

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                        </Style>

                                    </ToggleButton.Style>

                                </ToggleButton>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ÚLTIMA ACTUALIZACIÓN"
                        Binding="{Binding updated_at,
                                          StringFormat=dd/MM/yyyy HH:mm}"
                        Width="220"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>