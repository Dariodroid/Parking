<Window x:Class="Parking.UI.Windows.View.Pages.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activar sistema de parqueadero" Width="610" Height="475"
        MinWidth="540" MinHeight="430" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppPageBrush}">
    <Border Margin="20" Padding="22" CornerRadius="12" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="ACTIVACIÓN DE LICENCIA" FontSize="23" FontWeight="Bold"
                       Foreground="{DynamicResource AppTextBrush}"/>
            <TextBlock Grid.Row="1" Margin="0,7,0,18" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       Text="Envíe este código al proveedor. Pegue el serial recibido para activar el sistema en este equipo."/>
            <TextBlock Grid.Row="2" Text="CÓDIGO DE INSTALACIÓN" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppMutedTextBrush}"/>
            <DockPanel Grid.Row="3" Margin="0,5,0,18">
                <Button DockPanel.Dock="Right" Content="Copiar código" Width="125" Margin="8,0,0,0"
                        Click="CopyCode_Click"/>
                <TextBox x:Name="CodeText" IsReadOnly="True" Height="36" VerticalContentAlignment="Center"
                         FontWeight="SemiBold" FontSize="15"
                         Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                         BorderBrush="{DynamicResource AppInputBorderBrush}"/>
            </DockPanel>
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="SERIAL RECIBIDO" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                <TextBox x:Name="LicenseText" Grid.Row="1" Margin="0,5,0,12"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                         BorderBrush="{DynamicResource AppInputBorderBrush}"/>
            </Grid>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="110" Height="38" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Activar serial" Width="150" Height="38" Background="#1565C0"
                        Foreground="White" Click="Activate_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
