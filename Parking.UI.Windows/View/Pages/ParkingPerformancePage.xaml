<UserControl x:Class="Parking.UI.Windows.View.Pages.ParkingPerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppPageBrush}" FontFamily="Segoe UI">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="DESDE" Foreground="{DynamicResource AppMutedTextBrush}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Width="145" SelectedDate="{Binding StartDate}"
                            Foreground="{DynamicResource AppTextBrush}" Background="{DynamicResource AppInputBrush}"/>
                <TextBlock Text="HASTA" Foreground="{DynamicResource AppMutedTextBrush}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,8,0"/>
                <DatePicker Width="145" SelectedDate="{Binding EndDate}"
                            Foreground="{DynamicResource AppTextBrush}" Background="{DynamicResource AppInputBrush}"/>
                <Button Command="{Binding RefreshCommand}" Height="44" MinWidth="142"
                        Background="#245A81" Foreground="White" Margin="16,0,8,0" Padding="15,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DatabaseRefresh" Width="18" Height="18"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ACTUALIZAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportExcelCommand}" Height="44" MinWidth="112"
                        Background="#2E7D32" Foreground="White" Margin="0,0,8,0" Padding="15,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="EXCEL" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportWordCommand}" Height="44" MinWidth="112"
                        Background="#245A81" Foreground="White" Margin="0,0,8,0" Padding="15,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileWord" Width="18" Height="18"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="WORD" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding PrintCommand}" CommandParameter="{Binding ElementName=ReportSheet}"
                        Height="44" MinWidth="125"
                        Background="#245A81" Foreground="White" Padding="15,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Printer" Width="18" Height="18"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
        <!-- La hoja completa crece; solo el visor exterior tiene desplazamiento. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Padding="18">
            <Border x:Name="ReportSheet" Width="1050" MinHeight="680" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="White" BorderBrush="#D4DFE7" BorderThickness="1" Padding="42">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="5" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="SISTEMA DE GESTIÓN DE PARQUEADERO" Foreground="#596B7A"
                               FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="OCUPACIÓN Y RECAUDACIÓN" Foreground="#17324D"
                               FontSize="28" FontWeight="Bold" Margin="0,3,0,2"/>
                    <TextBlock Text="{Binding Report.GeneratedAt, StringFormat='Emitido: {0:dd/MM/yyyy HH:mm}'}"
                               Foreground="#596B7A" Margin="0,0,0,16"/>
                    <Border Height="3" Background="#245A81" Margin="0,0,0,18"/>
                    <TextBlock Text="{Binding AppliedStartDate, StringFormat='Período desde {0:dd/MM/yyyy}'}"
                               Foreground="#17324D" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AppliedEndDate, StringFormat='Hasta {0:dd/MM/yyyy}'}"
                               Foreground="#596B7A" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Report.Capacity, StringFormat='Capacidad actual: {0:N0} puestos'}"
                               Foreground="#596B7A" Margin="0,3,0,15"/>
                    <UniformGrid Columns="4" Margin="-4,0,-4,16">
                        <Border Background="#EAF1F6" Padding="15" Margin="4">
                            <StackPanel><TextBlock Text="ENTRADAS" Foreground="#596B7A" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Report.TotalEntries, StringFormat=N0}"
                                           Foreground="#17324D" FontSize="24" FontWeight="Bold"/></StackPanel>
                        </Border>
                        <Border Background="#EAF1F6" Padding="15" Margin="4">
                            <StackPanel><TextBlock Text="SALIDAS" Foreground="#596B7A" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Report.TotalExits, StringFormat=N0}"
                                           Foreground="#17324D" FontSize="24" FontWeight="Bold"/></StackPanel>
                        </Border>
                        <Border Background="#EAF1F6" Padding="15" Margin="4">
                            <StackPanel><TextBlock Text="OCUPACIÓN" Foreground="#596B7A" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Report.OccupancyPercent, StringFormat={}{0:N1}%}"
                                           Foreground="#245A81" FontSize="24" FontWeight="Bold"/></StackPanel>
                        </Border>
                        <Border Background="#EAF1F6" Padding="15" Margin="4">
                            <StackPanel><TextBlock Text="COBRADO REGISTRADO" Foreground="#596B7A" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Report.TotalCollected, Converter={StaticResource CurrencyConverter}}"
                                           Foreground="#245A81" FontSize="24" FontWeight="Bold"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="EVOLUCIÓN DIARIA" Foreground="#245A81" FontWeight="Bold"
                               FontSize="15" Margin="0,0,0,8"/>
                    <Border Background="#245A81" Padding="10,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/><ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="82"/><ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="145"/><ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DÍA" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="ENTRADAS" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="SALIDAS" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="OCUPACIÓN" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Grid.Column="4" Text="ESTANCIA MEDIA" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Grid.Column="5" Text="HORA DE MÁS INGRESOS" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Grid.Column="6" Text="COBRADO" Foreground="White" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D4DFE7" BorderThickness="0,0,0,1" Padding="10,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="82"/><ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="145"/><ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat=dd/MM/yyyy}" Foreground="#17324D"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Entries}" Foreground="#17324D"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Exits}" Foreground="#17324D"/>
                                        <TextBlock Grid.Column="3" Text="{Binding OccupancyPercent, StringFormat={}{0:N1}%}" Foreground="#17324D"/>
                                        <TextBlock Grid.Column="4" Text="{Binding AverageStayMinutes, StringFormat={}{0:N0} min}" Foreground="#17324D"/>
                                        <TextBlock Grid.Column="5" Text="{Binding PeakEntryLabel}" Foreground="#17324D"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Collected, Converter={StaticResource CurrencyConverter}}" Foreground="#17324D"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Status}" Foreground="#9D2F2F" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock Text="Entradas, salidas y ocupación provienen de las sesiones. Cobrado proviene exclusivamente de payments, según la fecha de cobro. Se muestra cada día del período elegido, incluso si no hubo pagos ese día. El día de hoy se mide hasta la hora de emisión."
                               Foreground="#596B7A" TextWrapping="Wrap" FontSize="11" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
