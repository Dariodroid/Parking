<UserControl x:Class="Parking.UI.Windows.View.Pages.ApplicationSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppPageBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Apariencia, tickets y conexión" FontSize="25" FontWeight="Bold"
                       Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="Estas preferencias pertenecen a este equipo y a tu usuario de Windows."
                       Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,20"/>

            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="TEMA" Foreground="{DynamicResource AppAccentTextBrush}"
                               FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Oscuro" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                     Foreground="{DynamicResource AppTextBrush}" Margin="0,0,24,0"/>
                        <RadioButton Content="Claro" IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                     Foreground="{DynamicResource AppTextBrush}"/>
                    </StackPanel>
                    <TextBlock Text="El cambio de tema se aplica y guarda al momento."
                               Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16"
                    Visibility="{Binding CanManageCurrency, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="MONEDA" Foreground="{DynamicResource AppAccentTextBrush}"
                               FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                    <TextBlock Text="Signo mostrado en cobros e informes" Foreground="{DynamicResource AppTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" MaxLength="8"
                                 Width="105" Height="42" Padding="9,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                                 BorderBrush="{DynamicResource AppInputBorderBrush}" CaretBrush="{DynamicResource AppTextBrush}"/>
                        <Button Content="Guardar signo" Command="{Binding SaveCurrencyCommand}"
                                Background="#2E7D32" Foreground="White" Height="42" MinWidth="165"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                Padding="14,0" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrencyPreview, StringFormat=Ejemplo: {0}}"
                               Foreground="{DynamicResource AppTextBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="Solo cambia la presentación en este perfil de Windows. Las cantidades y los pagos guardados no se convierten."
                               Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16"
                    Visibility="{Binding CanManagePrinter, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="IMPRESIÓN DE TICKETS" Foreground="{DynamicResource AppAccentTextBrush}"
                               FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                    <TextBlock Text="Impresora instalada en Windows" Foreground="{DynamicResource AppTextBrush}"
                               Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Buscar impresoras"
                                Command="{Binding RefreshTicketPrintersCommand}" Margin="10,0,0,0"
                                MinWidth="160" Padding="12,5" Foreground="{DynamicResource AppTextBrush}"
                                Background="{DynamicResource AppRaisedBrush}"/>
                        <ComboBox ItemsSource="{Binding TicketPrinters}" SelectedItem="{Binding SelectedTicketPrinter, Mode=TwoWay}"
                                  MinHeight="40" VerticalContentAlignment="Center"
                                  Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                                  BorderBrush="{DynamicResource AppInputBorderBrush}"/>
                    </DockPanel>
                    <TextBlock Text="Ancho del papel (mm)" Foreground="{DynamicResource AppTextBrush}"
                               Margin="0,14,0,6"/>
                    <ComboBox ItemsSource="{Binding TicketPaperWidths}" SelectedItem="{Binding TicketPaperWidthMm, Mode=TwoWay}"
                              Width="125" HorizontalAlignment="Left" MinHeight="40"
                              Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                              BorderBrush="{DynamicResource AppInputBorderBrush}"/>
                    <CheckBox Content="Imprimir automáticamente al registrar una entrada ocasional"
                              IsChecked="{Binding AutoPrintTickets, Mode=TwoWay}"
                              Foreground="{DynamicResource AppTextBrush}" Margin="0,14,0,0"/>
                    <TextBlock Text="Configure también 58 u 80 mm en el controlador de Windows. Las entradas mensualizadas válidas no generan ticket."
                               Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    <Button Content="Guardar impresora" Command="{Binding SaveTicketPrinterCommand}"
                            Background="#2E7D32" Foreground="White" Height="44" MinWidth="175"
                            HorizontalAlignment="Left" Padding="15,0" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20"
                    Visibility="{Binding CanManageConnection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="BASE DE DATOS SQL SERVER" Foreground="{DynamicResource AppAccentTextBrush}"
                               FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                    <TextBlock Text="Cadena de conexión de esta instalación" Foreground="{DynamicResource AppTextBrush}"
                               Margin="0,0,0,7"/>
                    <TextBox Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                             BorderBrush="{DynamicResource AppInputBorderBrush}" CaretBrush="{DynamicResource AppTextBrush}"
                             TextWrapping="Wrap" VerticalContentAlignment="Center" MinHeight="68" Padding="10"
                             ToolTip="Server=SERVIDOR\SQLEXPRESS;Database=parking_db;Trusted_Connection=True;TrustServerCertificate=True;"/>
                    <TextBlock Text="Ejemplo: Server=SERVIDOR\SQLEXPRESS;Database=parking_db;Trusted_Connection=True;TrustServerCertificate=True;"
                               Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock Text="Para autenticación SQL use User ID y Password en lugar de Trusted_Connection. La cadena se cifra al guardarla."
                               Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Probar conexión" Command="{Binding TestConnectionCommand}"
                                Background="#1769A8" Foreground="White" Height="46" MinWidth="180"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                Padding="16,0" Margin="0,0,8,0"/>
                        <Button Content="Guardar conexión" Command="{Binding SaveConnectionCommand}"
                                Background="#2E7D32" Foreground="White" Height="46" MinWidth="195"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                Padding="16,0" Margin="0,0,8,0"/>
                        <Button Content="Reiniciar ahora" Command="{Binding RestartCommand}"
                                Background="{DynamicResource AppRaisedBrush}" Foreground="{DynamicResource AppTextBrush}"
                                Height="46" MinWidth="175" VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center" Padding="16,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppTextBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

