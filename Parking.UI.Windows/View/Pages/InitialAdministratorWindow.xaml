<Window x:Class="Parking.UI.Windows.View.Pages.InitialAdministratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear administrador inicial" Width="520" Height="510"
        MinWidth="480" MinHeight="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppPageBrush}">
    <Border Margin="20" Padding="22" CornerRadius="12"
            Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="PRIMERA CONFIGURACIÓN" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource AppAccentTextBrush}"/>
            <TextBlock Text="Crear administrador" FontSize="25" FontWeight="Bold" Margin="0,6,0,7"
                       Foreground="{DynamicResource AppTextBrush}"/>
            <TextBlock Text="Esta base de datos todavía no tiene usuarios. Cree la primera cuenta para entrar al sistema y registrar a los operadores."
                       TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource AppMutedTextBrush}"/>

            <TextBlock Text="USUARIO" Foreground="{DynamicResource AppMutedTextBrush}" FontWeight="SemiBold"/>
            <TextBox x:Name="UsernameInput" MaxLength="50" Height="36" Margin="0,4,0,12"
                     Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                     BorderBrush="{DynamicResource AppInputBorderBrush}"/>

            <TextBlock Text="NOMBRE COMPLETO" Foreground="{DynamicResource AppMutedTextBrush}" FontWeight="SemiBold"/>
            <TextBox x:Name="FullNameInput" MaxLength="120" Height="36" Margin="0,4,0,12"
                     Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                     BorderBrush="{DynamicResource AppInputBorderBrush}"/>

            <TextBlock Text="CONTRASEÑA (MÍNIMO 12 CARACTERES)" Foreground="{DynamicResource AppMutedTextBrush}" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordInput" Height="36" Margin="0,4,0,12"
                         Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                         BorderBrush="{DynamicResource AppInputBorderBrush}"/>

            <TextBlock Text="CONFIRMAR CONTRASEÑA" Foreground="{DynamicResource AppMutedTextBrush}" FontWeight="SemiBold"/>
            <PasswordBox x:Name="ConfirmPasswordInput" Height="36" Margin="0,4,0,10"
                         Background="{DynamicResource AppInputBrush}" Foreground="{DynamicResource AppTextBrush}"
                         BorderBrush="{DynamicResource AppInputBorderBrush}"/>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="24" Foreground="#EF5350"/>
            <Button x:Name="CreateButton" Content="CREAR ADMINISTRADOR" Height="42" Margin="0,8,0,0"
                    Background="#1565C0" Foreground="White" FontWeight="Bold" Click="CreateButton_Click"/>
        </StackPanel>
    </Border>
</Window>
