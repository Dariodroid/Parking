<UserControl x:Class="Parking.UI.Windows.View.Pages.VehicleTypePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Parking.UI.Windows.Converters"
             mc:Ignorable="d"
             Background="#121212"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <UserControl.Resources>

        <conv:BooleanToCheckConverter x:Key="BooleanToCheckConverter"/>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="MinWidth" Value="95"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- HEADER OSCURO -->
        <Style x:Key="DarkDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- FORMULARIO -->
                <Border Style="{StaticResource SectionStyle}">

                    <StackPanel>

                        <TextBlock Text="TIPO DE VEHÍCULO"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="NOMBRE"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="ICONO"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="TARIFA POR HORA"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding HourlyRate, UpdateSourceTrigger=LostFocus}"
                                 PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="MINUTOS DE GRACIA"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding GraceMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="MINUTOS POR FRACCIÓN"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding FractionMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="IntegerTextBox_PreviewTextInput"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="TARIFA FRACCIÓN"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding FractionRate, UpdateSourceTrigger=LostFocus}"
                                 PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="ESTADO"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,4,0,6"/>

                        <ToggleButton IsChecked="{Binding IsActive, Mode=TwoWay}"
                                      Width="150"
                                      Height="36"
                                      HorizontalAlignment="Left"
                                      Cursor="Hand"
                                      BorderThickness="0"
                                      Focusable="False"
                                      Margin="0,0,0,8">

                            <ToggleButton.Template>

                                <ControlTemplate TargetType="ToggleButton">

                                    <Border Background="Transparent">

                                        <Grid Width="150"
                                              Height="36">

                                            <Border x:Name="SwitchBackground"
                                                    CornerRadius="18"
                                                    Background="#2E7D32"/>

                                            <TextBlock x:Name="SwitchText"
                                                       Text="ACTIVO"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>

                                            <Border x:Name="Knob"
                                                    Width="28"
                                                    Height="28"
                                                    CornerRadius="14"
                                                    Background="White"
                                                    HorizontalAlignment="Right"
                                                    Margin="4"/>

                                        </Grid>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsChecked"
                                                 Value="False">

                                            <Setter TargetName="SwitchBackground"
                                                    Property="Background"
                                                    Value="#666666"/>

                                            <Setter TargetName="SwitchText"
                                                    Property="Text"
                                                    Value="INACTIVO"/>

                                            <Setter TargetName="Knob"
                                                    Property="HorizontalAlignment"
                                                    Value="Left"/>

                                        </Trigger>

                                        <Trigger Property="IsChecked"
                                                 Value="True">

                                            <Setter TargetName="SwitchBackground"
                                                    Property="Background"
                                                    Value="#2E7D32"/>

                                            <Setter TargetName="SwitchText"
                                                    Property="Text"
                                                    Value="ACTIVO"/>

                                            <Setter TargetName="Knob"
                                                    Property="HorizontalAlignment"
                                                    Value="Right"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </ToggleButton.Template>

                        </ToggleButton>

                    </StackPanel>

                </Border>

                <!-- BOTONES -->
                <Border Style="{StaticResource SectionStyle}">

                    <StackPanel Orientation="Horizontal">

                        <Button Content="GUARDAR"
                                Command="{Binding SaveCommand}"
                                Background="#2E7D32"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="ACTUALIZAR"
                                Command="{Binding UpdateCommand}"
                                Background="#1565C0"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="NUEVO"
                                Command="{Binding NewCommand}"
                                Background="#333333"
                                Foreground="#DDDDDD"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="ELIMINAR"
                                Command="{Binding DeleteCommand}"
                                Background="#C62828"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                    </StackPanel>

                </Border>

                <!-- LOG -->
                <Border Style="{StaticResource SectionStyle}">

                    <StackPanel>

                        <TextBlock Text="ESTADO"
                                   Foreground="#888888"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#CCCCCC"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- TABLA -->
        <Border Grid.Column="2"
                Background="#1A1A1A"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6">

            <DataGrid ItemsSource="{Binding VehicleTypes}"
                      SelectedItem="{Binding SelectedVehicleType, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      Background="#1A1A1A"
                      Foreground="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowBackground="#1A1A1A"
                      AlternatingRowBackground="#202020"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      ColumnHeaderStyle="{StaticResource DarkDataGridHeaderStyle}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Icono"
                                        Binding="{Binding icon}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Hora"
                                        Binding="{Binding hourly_rate, StringFormat={}{0:N2}}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Gracia"
                                        Binding="{Binding grace_minutes}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Fracción"
                                        Binding="{Binding fraction_minutes}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Tarifa Fracción"
                                        Binding="{Binding fraction_rate, StringFormat={}{0:N2}}"
                                        Width="120"/>

                    <DataGridTemplateColumn Header="Activo"
                                            Width="65">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Text="{Binding is_active, Converter={StaticResource BooleanToCheckConverter}}"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>