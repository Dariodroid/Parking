<UserControl x:Class="Parking.UI.Windows.View.Pages.RegisteredVehiclePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Parking.UI.Windows.Converters"
             mc:Ignorable="d"
             Background="#121212"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <UserControl.Resources>

        <conv:BooleanToCheckConverter x:Key="BooleanToCheckConverter"/>

        <!-- ========================= -->
        <!-- ESTILOS GENERALES -->
        <!-- ========================= -->

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- ========================= -->
        <!-- COMBOBOX OSCURO -->
        <!-- ========================= -->

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">

            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,0,6"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">

                                <Grid>

                                    <ContentPresenter Margin="10,0,35,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      TextElement.Foreground="White"/>

                                    <ToggleButton Grid.Column="1"
                                                  HorizontalAlignment="Right"
                                                  Width="30"
                                                  Focusable="False"
                                                  Background="#1E1E1E"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">

                                        <TextBlock Text="▼"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </ToggleButton>

                                </Grid>

                            </Border>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">

                                <Border Background="#1E1E1E"
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>

                    <Style TargetType="ComboBoxItem">

                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#1E1E1E"/>
                        <Setter Property="Padding" Value="8,5"/>

                        <Style.Triggers>

                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#2D2D2D"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- ========================= -->
        <!-- DATEPICKER -->
        <!-- ========================= -->

        <Style x:Key="DarkDatePickerStyle" TargetType="DatePicker">

            <Style.Resources>

                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                         Color="#1565C0"/>

                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                         Color="White"/>

            </Style.Resources>

            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="DatePicker">

                        <Grid>

                            <Border Background="#0F0F0F"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="2">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Background="#0F0F0F"
                                               Foreground="White"
                                               BorderThickness="0"
                                               CaretBrush="White"
                                               Padding="8,3"/>

                                    <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Background="#1E1E1E"
                                    BorderThickness="0"
                                    Focusable="False">

                                        <TextBlock Text="📅"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                    </Button>

                                </Grid>

                            </Border>

                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">

                                <Border Background="#1E1E1E"
                                BorderBrush="#555555"
                                BorderThickness="1">

                                    <Calendar Background="#1E1E1E"
                                      Foreground="White"/>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>s
        <!-- ========================= -->
        <!-- BOTONES -->
        <!-- ========================= -->

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <!-- ========================= -->
        <!-- DATAGRID -->
        <!-- ========================= -->

        <Style x:Key="DarkDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>

            <Style.Triggers>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Grid Margin="8">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- CLIENTE -->
                <Border Style="{StaticResource SectionStyle}">

                    <StackPanel>

                        <TextBlock Text="CLIENTE MENSUALIZADO"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="PLACA"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBox Text="{Binding Plate}"
                                         Style="{StaticResource InputStyle}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="TIPO VEHÍCULO"
                                           Style="{StaticResource LabelStyle}"/>

                                <ComboBox ItemsSource="{Binding VehicleTypes}"
                                          SelectedValue="{Binding VehicleTypeId}"
                                          SelectedValuePath="id"
                                          DisplayMemberPath="name"
                                          Style="{StaticResource DarkComboBoxStyle}"/>

                            </StackPanel>

                        </Grid>

                        <TextBlock Text="NOMBRE PROPIETARIO"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding OwnerName}"
                                 Style="{StaticResource InputStyle}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="TELÉFONO"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBox Text="{Binding OwnerPhone}"
                                         Style="{StaticResource InputStyle}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="CÉDULA"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBox Text="{Binding OwnerCedula}"
                                         Style="{StaticResource InputStyle}"/>

                            </StackPanel>

                        </Grid>

                        <TextBlock Text="EMAIL"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding OwnerEmail}"
                                 Style="{StaticResource InputStyle}"/>

                    </StackPanel>

                </Border>

                <!-- CONFIG -->
                <Border Style="{StaticResource SectionStyle}">

                    <StackPanel>

                        <TextBlock Text="CONFIGURACIÓN MENSUALIDAD"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="VALOR MENSUAL"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBox Text="{Binding MonthlyFee}"
                                         Style="{StaticResource InputStyle}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="ESTADO"
                                           Style="{StaticResource LabelStyle}"/>

                                <ToggleButton IsChecked="{Binding IsActive}"
                                              Width="140"
                                              Height="30"
                                              HorizontalAlignment="Left"
                                              Cursor="Hand"
                                              BorderThickness="0">

                                    <ToggleButton.Template>

                                        <ControlTemplate TargetType="ToggleButton">

                                            <Grid Width="140"
                                                  Height="30">

                                                <Border x:Name="SwitchBackground"
                                                        Background="#2E7D32"
                                                        CornerRadius="15"/>

                                                <TextBlock x:Name="SwitchText"
                                                           Text="ACTIVO"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>

                                                <Border x:Name="Knob"
                                                        Width="22"
                                                        Height="22"
                                                        CornerRadius="11"
                                                        Background="White"
                                                        HorizontalAlignment="Right"
                                                        Margin="4"/>

                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsChecked"
                                                         Value="False">

                                                    <Setter TargetName="SwitchBackground"
                                                            Property="Background"
                                                            Value="#666666"/>

                                                    <Setter TargetName="SwitchText"
                                                            Property="Text"
                                                            Value="INACTIVO"/>

                                                    <Setter TargetName="Knob"
                                                            Property="HorizontalAlignment"
                                                            Value="Left"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </ToggleButton.Template>

                                </ToggleButton>

                            </StackPanel>

                        </Grid>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="FECHA INICIO"
                                           Style="{StaticResource LabelStyle}"/>

                                <DatePicker SelectedDate="{Binding MonthlyStartDate}"
                                            Style="{StaticResource DarkDatePickerStyle}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="FECHA FIN"
                                           Style="{StaticResource LabelStyle}"/>

                                <DatePicker SelectedDate="{Binding MonthlyEndDate}"
                                            Style="{StaticResource DarkDatePickerStyle}"/>

                            </StackPanel>

                        </Grid>

                        <TextBlock Text="OBSERVACIONES"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Notes}"
                                 Height="60"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource InputStyle}"/>

                    </StackPanel>

                </Border>

                <!-- BOTONES -->
                <Border Style="{StaticResource SectionStyle}">

                    <WrapPanel>

                        <Button Content="GUARDAR"
                                Command="{Binding SaveCommand}"
                                Background="#2E7D32"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="ACTUALIZAR"
                                Command="{Binding UpdateCommand}"
                                Background="#1565C0"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="NUEVO"
                                Command="{Binding NewCommand}"
                                Background="#333333"
                                Foreground="#DDDDDD"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="ELIMINAR"
                                Command="{Binding DeleteCommand}"
                                Background="#C62828"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                    </WrapPanel>

                </Border>

                <!-- ESTADO -->
                <Border Style="{StaticResource SectionStyle}">

                    <StackPanel>

                        <TextBlock Text="ESTADO"
                                   Foreground="#888888"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#CCCCCC"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- TABLA -->
        <Border Grid.Column="2"
                Background="#1A1A1A"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6">

            <DataGrid ItemsSource="{Binding RegisteredVehicles}"
                      SelectedItem="{Binding SelectedRegisteredVehicle}"
                      AutoGenerateColumns="False"
                      Background="#1A1A1A"
                      Foreground="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowBackground="#1A1A1A"
                      AlternatingRowBackground="#202020"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      ColumnHeaderStyle="{StaticResource DarkDataGridHeaderStyle}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Placa"
                                        Binding="{Binding plate}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Propietario"
                                        Binding="{Binding owner_name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Teléfono"
                                        Binding="{Binding owner_phone}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Mensualidad"
                                        Binding="{Binding monthly_fee, StringFormat={}{0:N2}}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Inicio"
                                        Binding="{Binding monthly_start_date, StringFormat=dd/MM/yyyy}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Fin"
                                        Binding="{Binding monthly_end_date, StringFormat=dd/MM/yyyy}"
                                        Width="90"/>

                    <DataGridTemplateColumn Header="Activo"
                                            Width="70">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Text="{Binding is_active, Converter={StaticResource BooleanToCheckConverter}}"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>