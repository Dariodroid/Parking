<UserControl x:Class="Parking.UI.Windows.View.Pages.RegisteredVehiclePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Parking.UI.Windows.Converters"
             mc:Ignorable="d"
             Background="#121212"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <UserControl.Resources>

        <Style x:Key="DarkComboBoxStyle"
       TargetType="ComboBox">

            <Setter Property="Height"
            Value="30"/>

            <Setter Property="Background"
            Value="#0A0A0A"/>

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="BorderBrush"
            Value="#444444"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="Padding"
            Value="6,2"/>

            <Setter Property="FontSize"
            Value="12"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Margin="8,0,0,0"
           VerticalAlignment="Center"
           Foreground="White"
           Text="{Binding SelectedItem.name,
                          RelativeSource={RelativeSource TemplatedParent}}"/>

                                    <ToggleButton Grid.Column="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="#1E1E1E"
                                          BorderThickness="0">

                                        <TextBlock Text="▼"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                    </ToggleButton>

                                </Grid>

                            </Border>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">

                                <Border Background="#0A0A0A"
                                BorderBrush="#444444"
                                BorderThickness="1">

                                    <ScrollViewer>

                                        <StackPanel IsItemsHost="True"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
        <conv:BooleanToCheckConverter x:Key="BooleanToCheckConverter"/>

        <!-- ========================= -->
        <!-- ESTILOS GENERALES -->
        <!-- ========================= -->

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- ========================= -->
        <!-- HORARIOS MODERNOS -->
        <!-- ========================= -->

        <Style x:Key="ModernScheduleCardStyle"
       TargetType="Border">

            <Setter Property="Background"
            Value="#1C1C1C"/>

            <Setter Property="CornerRadius"
            Value="10"/>

            <Setter Property="Padding"
            Value="12"/>

            <Setter Property="Margin"
            Value="0,0,0,8"/>

            <Setter Property="BorderBrush"
            Value="#2B2B2B"/>

            <Setter Property="BorderThickness"
            Value="1"/>

        </Style>

        <Style x:Key="ModernHourBoxStyle"
       TargetType="TextBox">

            <Setter Property="Width"
            Value="90"/>

            <Setter Property="Height"
            Value="38"/>

            <Setter Property="Background"
            Value="#101010"/>

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="BorderBrush"
            Value="#333333"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="FontSize"
            Value="13"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Padding"
            Value="10,0"/>

            <Setter Property="HorizontalContentAlignment"
            Value="Center"/>

            <Setter Property="VerticalContentAlignment"
            Value="Center"/>

            <Setter Property="CaretBrush"
            Value="White"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="ModernDayCheckStyle"
       TargetType="CheckBox">

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="FontWeight"
            Value="Bold"/>

            <Setter Property="FontSize"
            Value="13"/>

            <Setter Property="VerticalAlignment"
            Value="Center"/>

        </Style>

        <Style x:Key="ModernFullDayCheckStyle"
       TargetType="CheckBox">

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="HorizontalAlignment"
            Value="Center"/>

            <Setter Property="VerticalAlignment"
            Value="Center"/>

        </Style>

        <!-- ========================= -->
        <!-- CHECKBOX MODERNO -->
        <!-- ========================= -->

        <Style x:Key="ModernToggleCheckStyle"
       TargetType="CheckBox">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <Grid Cursor="Hand">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- SWITCH -->
                            <Border x:Name="SwitchTrack"
                            Width="42"
                            Height="22"
                            Background="#444444"
                            CornerRadius="11"
                            VerticalAlignment="Center">

                                <Ellipse x:Name="SwitchThumb"
                                 Width="18"
                                 Height="18"
                                 Fill="White"
                                 HorizontalAlignment="Left"
                                 Margin="2,0,0,0"/>

                            </Border>

                            <!-- TEXTO -->
                            <ContentPresenter Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Margin="10,0,0,0"
                                      TextElement.Foreground="White"
                                      TextElement.FontWeight="SemiBold"
                                      TextElement.FontSize="13"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                             Value="True">

                                <Setter TargetName="SwitchTrack"
                                Property="Background"
                                Value="#2E7D32"/>

                                <Setter TargetName="SwitchThumb"
                                Property="HorizontalAlignment"
                                Value="Right"/>

                                <Setter TargetName="SwitchThumb"
                                Property="Margin"
                                Value="0,0,2,0"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================= -->
        <!-- BOTONES HORA -->
        <!-- ========================= -->

        <Style x:Key="HourButtonStyle"
       TargetType="Button">

            <Setter Property="Width"
            Value="24"/>

            <Setter Property="Height"
            Value="18"/>

            <Setter Property="Background"
            Value="#252525"/>

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="BorderBrush"
            Value="#333333"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="FontWeight"
            Value="Bold"/>

            <Setter Property="FontSize"
            Value="10"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
        <!-- ========================= -->
        <!-- BOTONES -->
        <!-- ========================= -->

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <!-- ========================= -->
        <!-- DATAGRID -->
        <!-- ========================= -->

        <Style x:Key="DarkDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>

            <Style.Triggers>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Grid Margin="8">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- CLIENTE -->
                <Border Style="{StaticResource SectionStyle}">

                    <StackPanel>

                        <TextBlock Text="CLIENTE MENSUALIZADO"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="PLACA"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBox Text="{Binding Plate}"
                                         Style="{StaticResource InputStyle}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="TIPO VEHÍCULO"
                                           Style="{StaticResource LabelStyle}"/>

                               
                                <ComboBox ItemsSource="{Binding VehicleTypes}"
          SelectedValue="{Binding VehicleTypeId}"
          SelectedValuePath="id"
          DisplayMemberPath="name"
          Style="{StaticResource DarkComboBoxStyle}"/>

                            </StackPanel>

                        </Grid>

                        <TextBlock Text="NOMBRE PROPIETARIO"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding OwnerName}"
                                 Style="{StaticResource InputStyle}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="TELÉFONO"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBox Text="{Binding OwnerPhone}"
                                         Style="{StaticResource InputStyle}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="CÉDULA"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBox Text="{Binding OwnerCedula}"
                                         Style="{StaticResource InputStyle}"/>

                            </StackPanel>

                        </Grid>

                        <TextBlock Text="EMAIL"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding OwnerEmail}"
                                 Style="{StaticResource InputStyle}"/>

                    </StackPanel>

                </Border>

                <!-- CONFIG -->
                <Border Style="{StaticResource SectionStyle}">

                    <StackPanel>

                        <TextBlock Text="CONFIGURACIÓN MENSUALIDAD"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="VALOR MENSUAL"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBox Text="{Binding MonthlyFee}"
                                         Style="{StaticResource InputStyle}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="ESTADO"
                                           Style="{StaticResource LabelStyle}"/>

                                <ToggleButton IsChecked="{Binding IsActive}"
              Width="70"
              Height="30"
              Cursor="Hand"
              BorderThickness="0">

                                    <ToggleButton.Style>

                                        <Style TargetType="ToggleButton">

                                            <Setter Property="Background" Value="#C62828"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="ToggleButton">

                                                        <Border Width="70"
                                Height="30"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">

                                                            <Grid>

                                                                <Ellipse x:Name="SwitchThumb"
                                         Width="24"
                                         Height="24"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0"/>

                                                                <TextBlock x:Name="SwitchText"
                                           Text="OFF"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,10,0"/>

                                                            </Grid>

                                                        </Border>

                                                        <ControlTemplate.Triggers>

                                                            <Trigger Property="IsChecked"
                                     Value="True">

                                                                <Setter Property="Background"
                                        Value="#2E7D32"/>

                                                                <Setter TargetName="SwitchThumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>

                                                                <Setter TargetName="SwitchThumb"
                                        Property="Margin"
                                        Value="0,0,3,0"/>

                                                                <Setter TargetName="SwitchText"
                                        Property="Text"
                                        Value="ON"/>

                                                                <Setter TargetName="SwitchText"
                                        Property="HorizontalAlignment"
                                        Value="Left"/>

                                                                <Setter TargetName="SwitchText"
                                        Property="Margin"
                                        Value="10,0,0,0"/>

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                        </Style>

                                    </ToggleButton.Style>

                                </ToggleButton>

                            </StackPanel>

                        </Grid>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="FECHA INICIO"
                                           Style="{StaticResource LabelStyle}"/>

                                <DatePicker SelectedDate="{Binding MonthlyStartDate}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="FECHA FIN"
                                           Style="{StaticResource LabelStyle}"/>

                                <DatePicker SelectedDate="{Binding MonthlyEndDate}"/>

                            </StackPanel>

                        </Grid>

                        <TextBlock Text="OBSERVACIONES"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding Notes}"
                                 Height="60"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource InputStyle}"/>

                    </StackPanel>

                </Border>

                <!-- BOTONES -->
                <Border Style="{StaticResource SectionStyle}">

                    <WrapPanel>

                        <Button Content="GUARDAR"
                                Command="{Binding SaveCommand}"
                                Background="#2E7D32"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="ACTUALIZAR"
                                Command="{Binding UpdateCommand}"
                                Background="#1565C0"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="NUEVO"
                                Command="{Binding NewCommand}"
                                Background="#333333"
                                Foreground="#DDDDDD"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="ELIMINAR"
                                Command="{Binding DeleteCommand}"
                                Background="#C62828"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                    </WrapPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- PANEL DERECHO -->
        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="260"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TABLA VEHICULOS -->
            <Border Grid.Row="0"
                    Background="#1A1A1A"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6" Margin="0,0,0,2
                    " Grid.RowSpan="2">

                <DataGrid ItemsSource="{Binding RegisteredVehicles}"
                          SelectedItem="{Binding SelectedRegisteredVehicle}"
                          AutoGenerateColumns="False"
                          Background="#1A1A1A"
                          Foreground="White"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowBackground="#1A1A1A"
                          AlternatingRowBackground="#202020"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ColumnHeaderStyle="{StaticResource DarkDataGridHeaderStyle}" Margin="0,0,0,3">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Placa"
                                            Binding="{Binding plate}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Propietario"
                                            Binding="{Binding owner_name}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Teléfono"
                                            Binding="{Binding owner_phone}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Mensualidad"
                                            Binding="{Binding vehicle_monthly_plan.monthly_fee}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Inicio"
                                            Binding="{Binding vehicle_monthly_plan.start_date, StringFormat=dd/MM/yyyy}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Fin"
                                            Binding="{Binding vehicle_monthly_plan.end_date, StringFormat=dd/MM/yyyy}"
                                            Width="90"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <!-- HORARIOS MODERNOS -->
            <!-- HORARIOS MODERNOS -->
            <Border Grid.Row="2"
        Style="{StaticResource SectionStyle}"
        Margin="0,8,0,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TITULO -->
                    <DockPanel Grid.Row="0"
                   Margin="0,0,0,18">

                        <StackPanel DockPanel.Dock="Left">

                            <TextBlock Text="HORARIOS PERMITIDOS"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"/>

                            <TextBlock Text="Control de acceso semanal del vehículo"
                           Foreground="#8A8A8A"
                           FontSize="11"
                           Margin="0,2,0,0"/>

                        </StackPanel>

                    </DockPanel>

                    <!-- CABECERA -->
                    <Border Grid.Row="1"
                Background="#151515"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,10">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                           Text="DÍA"
                           Foreground="#8C8C8C"
                           FontWeight="Bold"
                           FontSize="11"/>

                            <TextBlock Grid.Column="1"
                           Text="ENTRADA"
                           Foreground="#8C8C8C"
                           FontWeight="Bold"
                           FontSize="11"
                           HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                           Text="SALIDA"
                           Foreground="#8C8C8C"
                           FontWeight="Bold"
                           FontSize="11"
                           HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                           Text="24H"
                           Foreground="#8C8C8C"
                           FontWeight="Bold"
                           FontSize="11"
                           HorizontalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <!-- LISTA -->
                    <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">

                        <ItemsControl ItemsSource="{Binding VehicleSchedules}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Style="{StaticResource ModernScheduleCardStyle}">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- DIA -->
                                            <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                                <Border Width="10"
                                            Height="10"
                                            CornerRadius="5"
                                            Margin="0,0,10,0">

                                                    <Border.Style>

                                                        <Style TargetType="Border">

                                                            <Setter Property="Background"
                                                        Value="#C62828"/>

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding IsEnabled}"
                                                                 Value="True">

                                                                    <Setter Property="Background"
                                                                Value="#2E7D32"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </Border.Style>

                                                </Border>

                                                <CheckBox Content="{Binding DayName}"
                                              IsChecked="{Binding IsEnabled}"
                                              Style="{StaticResource ModernToggleCheckStyle}"/>

                                            </StackPanel>

                                            <!-- HORA INICIO -->
                                            <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                                <TextBox Text="{Binding StartTime}"
                                             Style="{StaticResource ModernHourBoxStyle}"
                                             Width="80"
                                             IsEnabled="{Binding IsEnabled}"/>

                                                <StackPanel Margin="5,0,0,0">

                                                    <Button Content="▲"
                                                Style="{StaticResource HourButtonStyle}"
                                                Command="{Binding IncreaseStartHourCommand}"/>

                                                    <Button Content="▼"
                                                Style="{StaticResource HourButtonStyle}"
                                                Margin="0,2,0,0"
                                                Command="{Binding DecreaseStartHourCommand}"/>

                                                </StackPanel>

                                            </StackPanel>

                                            <!-- HORA FIN -->
                                            <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                                <TextBox Text="{Binding EndTime}"
                                             Style="{StaticResource ModernHourBoxStyle}"
                                             Width="80"
                                             IsEnabled="{Binding IsEnabled}"/>

                                                <StackPanel Margin="5,0,0,0">

                                                    <Button Content="▲"
                                                Style="{StaticResource HourButtonStyle}"
                                                Command="{Binding IncreaseEndHourCommand}"/>

                                                    <Button Content="▼"
                                                Style="{StaticResource HourButtonStyle}"
                                                Margin="0,2,0,0"
                                                Command="{Binding DecreaseEndHourCommand}"/>

                                                </StackPanel>

                                            </StackPanel>

                                            <!-- 24 HORAS -->
                                            <CheckBox Grid.Column="3"
                                          IsChecked="{Binding IsFullDay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernToggleCheckStyle}"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>
        </Grid>

    </Grid>

</UserControl>