<UserControl x:Class="Parking.UI.Windows.View.Pages.OperatorReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource AppPageBrush}" FontFamily="Segoe UI">
    <!-- Estilos compartidos de las acciones y de la tabla del informe. -->
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ReportHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#245A81"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#17324D"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#D4DFE7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="DESDE" Foreground="{DynamicResource AppMutedTextBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Width="140" SelectedDate="{Binding FromDate}" Foreground="{DynamicResource AppTextBrush}" Background="{DynamicResource AppInputBrush}"/>
                <TextBlock Text="HASTA" Foreground="{DynamicResource AppMutedTextBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="20,0,8,0"/>
                <DatePicker Width="140" SelectedDate="{Binding ToDate}" Foreground="{DynamicResource AppTextBrush}" Background="{DynamicResource AppInputBrush}"/>
                <Button Command="{Binding RefreshCommand}" Background="#245A81" Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabaseRefresh" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="ACTUALIZAR"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportExcelCommand}" Background="#2E7D32" Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="EXCEL"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportWordCommand}" Background="#245A81" Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileWord" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="WORD"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding PrintCommand}" CommandParameter="{Binding ElementName=ReportSheet}"
                        Background="#245A81" Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="IMPRIMIR"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
        <!-- La hoja crece con los registros; el desplazamiento pertenece al visor exterior. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Padding="18">
            <Border x:Name="ReportSheet" Width="1000" MinHeight="650" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Background="White" Padding="55"
                    BorderBrush="#D4DFE7" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="5" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="SISTEMA DE GESTIÓN DE PARQUEADERO"
                               Foreground="#596B7A" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="INFORME DE OPERADORES"
                               Foreground="#17324D" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ReportDate, StringFormat='Emitido: {0:dd/MM/yyyy HH:mm}'}"
                               Foreground="#596B7A" Margin="0,4,0,16"/>
                    <Border Height="3" Background="#245A81" Margin="0,0,0,22"/>
                    <!-- Resumen del último filtro aplicado, consistente con la exportación. -->
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DESDE" Foreground="#596B7A" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding AppliedFromDate, StringFormat=dd/MM/yyyy}" Foreground="#17324D" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="HASTA" Foreground="#596B7A" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding AppliedToDate, StringFormat=dd/MM/yyyy}" Foreground="#17324D" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="OPERADORES" Foreground="#596B7A" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ReportItems.Count}" Foreground="#17324D" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="COBROS" Foreground="#596B7A" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalPayments}" Foreground="#17324D" FontSize="16"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding ReportItems}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" MinHeight="210"
                              EnableRowVirtualization="False" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Background="White" Foreground="#17324D"
                              RowBackground="White" AlternatingRowBackground="#F1F5F8"
                              BorderBrush="#D4DFE7" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#D4DFE7"
                              HeadersVisibility="Column" RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource ReportHeader}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="OPERADOR" Binding="{Binding OperatorName}" Width="*"/>
                            <DataGridTextColumn Header="COBROS" Binding="{Binding TotalPayments}" Width="180"/>
                            <DataGridTextColumn Header="TOTAL RECAUDADO" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="#EAF1F6" BorderBrush="#D4DFE7" BorderThickness="1"
                            Padding="18" Margin="0,22,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="TOTAL GENERAL" Foreground="#17324D"
                                       FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalGeneral, Converter={StaticResource CurrencyConverter}}"
                                       Foreground="#245A81" FontSize="20" FontWeight="Bold" Margin="25,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Documento generado por el sistema de gestión de parqueadero."
                               Foreground="#596B7A" FontSize="11" Margin="0,28,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
