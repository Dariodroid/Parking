<UserControl x:Class="Parking.UI.Windows.View.Pages.OperatorReportPage" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#121212"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- ESTILO DE BOTONES MÁS GRANDES Y PROFESIONALES -->
        <Style x:Key="ReportActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="115"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO DE TABLA SIMPLE TIPO WORD (BLANCA CON LÍNEAS NEGRAS) -->
        <Style x:Key="WordTableHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- CELDAS -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>

                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- FILAS -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="White"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA HERRAMIENTAS -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="DESDE" Foreground="#9E9E9E" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- DATEPICKER DESDE CON TEXTO BLANCO -->
                <DatePicker Width="150" SelectedDate="{Binding FromDate}" Foreground="White" Background="#0A0A0A">
                    <DatePicker.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="White"/>
                        <Style TargetType="{x:Type DatePickerTextBox}">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#0A0A0A"/>
                            <Setter Property="CaretBrush" Value="White"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>

                <TextBlock Text="HASTA" Foreground="#9E9E9E" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,10,0"/>

                <!-- DATEPICKER HASTA CON TEXTO BLANCO -->
                <DatePicker Width="150" SelectedDate="{Binding ToDate}" Foreground="White" Background="#0A0A0A">
                    <DatePicker.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="White"/>
                        <Style TargetType="{x:Type DatePickerTextBox}">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#0A0A0A"/>
                            <Setter Property="CaretBrush" Value="White"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>

                <!-- BOTONES CON ICONOS -->
                <Button Command="{Binding RefreshCommand}" Background="#1565C0" Style="{StaticResource ReportActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DatabaseRefresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ACTUALIZAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ExportExcelCommand}" Background="#2E7D32" Style="{StaticResource ReportActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="EXCEL" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ExportWordCommand}" Background="#0D47A1" Style="{StaticResource ReportActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileWord" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="WORD" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding PrintCommand}" Background="#333333" Foreground="#DDDDDD" Style="{StaticResource ReportActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="IMPRIMIR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- HOJA -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    Padding="20">

                <Border x:Name="ReportContainer"
                        Width="1122"
                        Height="1587"
                        Background="White"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Padding="60">

                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="REPORTE DE OPERADORES"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="#1A1A1A"/>

                        <TextBlock Text="Sistema de Parqueadero"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,5"
                                   Foreground="#555555"/>

                        <Separator Margin="0,20" Background="#CCCCCC"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Fecha Inicio" FontWeight="Bold" Foreground="#1A1A1A"/>
                                <TextBlock Text="{Binding FromDate, StringFormat=dd/MM/yyyy}" Foreground="#333333" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Fecha Fin" FontWeight="Bold" Foreground="#1A1A1A"/>
                                <TextBlock Text="{Binding ToDate, StringFormat=dd/MM/yyyy}" Foreground="#333333" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- DATAGRID ESTILO WORD SIMPLE (BLANCO Y NEGRO) -->
                        <DataGrid ItemsSource="{Binding ReportItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Height="1100"
                                  Margin="0,20,0,0"

                                  Background="White"
                                  Foreground="Black"

                                  BorderBrush="Black"
                                  BorderThickness="1"

                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="Black"
                                  VerticalGridLinesBrush="Black"

                                  HeadersVisibility="Column"

                                  RowBackground="White"
                                  AlternatingRowBackground="White"

                                  RowHeaderWidth="0"

                                  ColumnHeaderStyle="{StaticResource WordTableHeaderStyle}">

                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="White"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="White"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Operador" Binding="{Binding OperatorName}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Cantidad Cobros" Binding="{Binding TotalPayments}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Total Recaudado" Binding="{Binding TotalAmount, StringFormat=C}" Width="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5,0"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,20,0,0" Padding="15" Background="#F5F5F5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="TOTAL GENERAL:" FontWeight="Bold" FontSize="18" Foreground="#1A1A1A"/>
                                <TextBlock Text="{Binding TotalGeneral, StringFormat=C}" FontWeight="Bold" FontSize="18" Margin="15,0,0,0" Foreground="#1565C0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Generado automáticamente por el sistema"
                                   HorizontalAlignment="Center"
                                   Margin="0,40,0,0"
                                   FontStyle="Italic"
                                   Foreground="#888888"/>

                    </StackPanel>

                </Border>

            </Border>

        </ScrollViewer>
    </Grid>
</UserControl>