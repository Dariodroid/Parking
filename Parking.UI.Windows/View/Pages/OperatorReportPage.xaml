<UserControl x:Class="Parking.UI.Windows.View.Pages.OperatorReportPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#121212">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- BARRA HERRAMIENTAS -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Desde" Foreground="White" VerticalAlignment="Center"/>
                <DatePicker Width="140" Margin="10,0" SelectedDate="{Binding FromDate}" />
                <TextBlock Text="Hasta" Foreground="White" VerticalAlignment="Center"/>
                <DatePicker Width="140" Margin="10,0" SelectedDate="{Binding ToDate}" />
                <Button Content="Actualizar" Width="110" Margin="20,0" Command="{Binding RefreshCommand}" />
                <Separator Width="20"/>
                <Button Content="Exportar Excel" Width="120" Command="{Binding ExportExcelCommand}" />
                <Button Content="Exportar Word" Width="120" Margin="10,0" Command="{Binding ExportWordCommand}" />
                <Button Content="Imprimir" Width="100" Margin="10,0" Command="{Binding PrintCommand}" />
            </StackPanel>
        </Border>
        <!-- HOJA -->
        <!-- HOJA -->
        <ScrollViewer Grid.Row="1"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              Padding="20">

            <Border HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="Transparent"
            Padding="20">

                <Border x:Name="ReportContainer"
                Width="1122"
                Height="1587"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="60">

                    <StackPanel>

                        <TextBlock Text="REPORTE DE OPERADORES"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                        <TextBlock Text="Sistema de Parqueadero"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,5"/>

                        <Separator Margin="0,20"/>

                        <Grid Margin="0,0,0,20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Fecha Inicio"
                                   FontWeight="Bold"/>

                                <TextBlock Text="{Binding FromDate,
                                          StringFormat=dd/MM/yyyy}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Fecha Fin"
                                   FontWeight="Bold"/>

                                <TextBlock Text="{Binding ToDate,
                                          StringFormat=dd/MM/yyyy}"/>
                            </StackPanel>

                        </Grid>

                        <DataGrid ItemsSource="{Binding ReportItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Height="1100"
                          Margin="0,20,0,0">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Operador"
                                            Binding="{Binding OperatorName}"
                                            Width="*"/>

                                <DataGridTextColumn Header="Cantidad Cobros"
                                            Binding="{Binding TotalPayments}"
                                            Width="180"/>

                                <DataGridTextColumn Header="Total Recaudado"
                                            Binding="{Binding TotalAmount,
                                                      StringFormat=C}"
                                            Width="200"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <Border BorderBrush="#444"
                        BorderThickness="1"
                        Margin="0,20,0,0"
                        Padding="15">

                            <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                                <TextBlock Text="TOTAL GENERAL:"
                                   FontWeight="Bold"
                                   FontSize="18"/>

                                <TextBlock Text="{Binding TotalGeneral,
                                          StringFormat=C}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Margin="15,0,0,0"/>

                            </StackPanel>

                        </Border>

                        <TextBlock Text="Generado automáticamente por el sistema"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"
                           FontStyle="Italic"/>

                    </StackPanel>

                </Border>

            </Border>

        </ScrollViewer>
    </Grid>
</UserControl>