<UserControl x:Class="Parking.UI.Windows.View.Pages.VehicleReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#121212">

    <UserControl.Resources>
        <!-- Agrupa datos relacionados en una sola celda sin recortar el texto. -->
        <Style x:Key="ReportMultilineCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <SolidColorBrush x:Key="WindowBg" Color="#121212"/>
        <SolidColorBrush x:Key="PanelBg" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="InputBg" Color="#141414"/>
        <SolidColorBrush x:Key="BorderDark" Color="#333333"/>
        <SolidColorBrush x:Key="TextNormal" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="TextHighlight" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#888888"/>
        <SolidColorBrush x:Key="AccentColor" Color="#E46D24"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextHighlight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextHighlight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#383838"/>
                    <Setter Property="BorderBrush" Value="#555"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A1A1A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="10"/>

                            <Border x:Name="Thumb" 
                                    Width="14" 
                                    Height="14" 
                                    CornerRadius="7" 
                                    Background="#A0A0A0" 
                                    HorizontalAlignment="Left" 
                                    Margin="3,0,0,0"
                                    VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="2" Color="Black" Direction="270" Opacity="0.3" ShadowDepth="1"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF8533"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnExcel" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#175231"/>
            <Setter Property="BorderBrush" Value="#1E6E41"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E6E41"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnWord" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1C3D7A"/>
            <Setter Property="BorderBrush" Value="#2551A3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2551A3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15">

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- GRUPO 1: Filtros de Texto -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Text="PLACA" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox Width="130" Text="{Binding Filter.Plate, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Text="PROPIETARIO" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox Width="170" Text="{Binding Filter.OwnerName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Border Background="#333333" Width="1" Height="25" Margin="0,0,20,5"/>

                <!-- GRUPO 2: Toggles -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Text="MENSUALES" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ToggleButton IsChecked="{Binding Filter.IncludeMonthly}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="OCASIONALES" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ToggleButton IsChecked="{Binding Filter.IncludeOccasional}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Text="DENTRO" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ToggleButton IsChecked="{Binding Filter.IncludeInside}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="FUERA" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ToggleButton IsChecked="{Binding Filter.IncludeOutside}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="#333333" Width="1" Height="25" Margin="0,0,20,5"/>

                <!-- GRUPO 3: Fechas -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Text="DESDE" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <DatePicker Width="130" SelectedDate="{Binding Filter.FromDate}" Foreground="White" Background="#0A0A0A">
                        <DatePicker.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="White"/>
                            <Style TargetType="{x:Type DatePickerTextBox}">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#0A0A0A"/>
                                <Setter Property="CaretBrush" Value="White"/>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>

                    <TextBlock Text="HASTA" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="15,0,8,0"/>
                    <DatePicker Width="130" SelectedDate="{Binding Filter.ToDate}" Foreground="White" Background="#0A0A0A">
                        <DatePicker.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="White"/>
                            <Style TargetType="{x:Type DatePickerTextBox}">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#0A0A0A"/>
                                <Setter Property="CaretBrush" Value="White"/>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                </StackPanel>

                <Border Background="#333333" Width="1" Height="25" Margin="0,0,20,5"/>

                <!-- GRUPO 4: Acciones con Iconos -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5" VerticalAlignment="Center">
                    <Button Command="{Binding SearchCommand}" MinWidth="110" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="BUSCAR" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnExcel}" Command="{Binding ExportExcelCommand}" MinWidth="100" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="EXCEL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnWord}" Command="{Binding ExportWordCommand}" MinWidth="100">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileWord" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="WORD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- Este visor desplaza la hoja completa; la tabla no mantiene un scroll vertical propio. -->
        <ScrollViewer x:Name="ReportScrollViewer" Grid.Row="1"
                      Background="#0A0A0A" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto"
                      Padding="20">

            <Border Width="1200" 
                    MinHeight="850" 
                    Background="White" 
                    Padding="60,50" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top">

                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="25" Direction="270" ShadowDepth="8" Opacity="0.5"/>
                </Border.Effect>

                <Border.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#111111"/>
                    </Style>

                    <Style TargetType="DataGrid">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#333333"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="RowBackground" Value="White"/>
                        <Setter Property="AlternatingRowBackground" Value="#F4F6F8"/>
                        <Setter Property="Foreground" Value="#111111"/>
                        <Setter Property="HorizontalGridLinesBrush" Value="#D0D0D0"/>
                        <Setter Property="VerticalGridLinesBrush" Value="#D0D0D0"/>
                        <Setter Property="HeadersVisibility" Value="Column"/>
                        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                        <Setter Property="CanUserResizeRows" Value="False"/>
                        <Setter Property="SelectionMode" Value="Single"/>
                    </Style>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#245A81"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderBrush" Value="#D4DFE7"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="#111111"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DCEAF6"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="SISTEMA DE GESTIÓN DE PARQUEADERO" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#666666"/>
                            <TextBlock Text="INFORME DETALLADO DE VEHÍCULOS"
                                       FontSize="26" 
                                       FontWeight="Black" 
                                       Foreground="#17324D"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Text="{Binding ReportDate, StringFormat='Emitido: {0:dd/MM/yyyy HH:mm}'}"
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Top" 
                                   Foreground="#555555" 
                                   FontStyle="Italic"/>

                        <Separator VerticalAlignment="Bottom" Margin="0,15,0,0" Background="#245A81" Height="3"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,22">
                        <TextBlock Text="{Binding AppliedPeriod, StringFormat='Período de búsqueda: {0}'}"
                                   Foreground="#17324D" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AppliedCriteria, StringFormat='Criterios: {0}'}"
                                   Foreground="#596B7A" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Vehicles.Count, StringFormat='Vehículos encontrados: {0}'}"
                                   Foreground="#17324D" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="Los mensuales muestran actividad histórica; los ocasionales, actividad del período seleccionado."
                                   Foreground="#596B7A" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Una sola tabla refleja las filas filtradas que se usan también al exportar. -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="VEHÍCULOS ENCONTRADOS" FontSize="18" FontWeight="Bold"
                                   Foreground="#245A81" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding ReportRows}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  EnableRowVirtualization="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ReportGrid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PLACA" Binding="{Binding Vehicle.Plate}" Width="105"/>
                                <DataGridTextColumn Header="PROPIETARIO" Binding="{Binding Vehicle.OwnerName}" Width="*"/>
                                <DataGridTextColumn Header="TIPO / CATEGORÍA" Binding="{Binding TypeAndCategory}"
                                                    ElementStyle="{StaticResource ReportMultilineCell}" Width="135"/>
                                <DataGridTextColumn Header="PLAN / CUOTA" Binding="{Binding PlanAndFee}"
                                                    ElementStyle="{StaticResource ReportMultilineCell}" Width="120"/>
                                <DataGridTextColumn Header="INGRESOS / MIN" Binding="{Binding Activity}"
                                                    ElementStyle="{StaticResource ReportMultilineCell}" Width="105"/>
                                <DataGridTextColumn Header="ÚLTIMOS MOVIMIENTOS" Binding="{Binding Movements}"
                                                    ElementStyle="{StaticResource ReportMultilineCell}" Width="200"/>
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Vehicle.CurrentStatus}" Width="75"/>
                                <DataGridTextColumn Header="COBRADO" Binding="{Binding Collected}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No se encontraron vehículos con los criterios seleccionados."
                                   Foreground="#596B7A" FontStyle="Italic" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Vehicles.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Row="3"
                            BorderBrush="#333333" 
                            BorderThickness="0,2,0,0" 
                            Margin="0,35,0,0" 
                            Padding="0,20,0,0">

                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Right" Margin="0,0,40,0">
                                    <TextBlock Text="TOTAL VEHÍCULOS" 
                                               Foreground="#555555" 
                                               HorizontalAlignment="Right" 
                                               FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Vehicles.Count}" 
                                               FontSize="24" 
                                               FontWeight="Black" 
                                               Foreground="#111111" 
                                               HorizontalAlignment="Right"/>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="TOTAL COBRADO MOSTRADO"
                                               Foreground="#555555" 
                                               HorizontalAlignment="Right" 
                                               FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalCollected, StringFormat=C}" 
                                               FontSize="24" 
                                               FontWeight="Black" 
                                               Foreground="#000000" 
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
