<UserControl x:Class="Parking.UI.Windows.View.Pages.VehicleReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE FILTROS -->

        <Border Grid.Row="0"
                Background="#1E1E1E"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Placa"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <TextBox Width="120"
                         Margin="10,0"
                         Text="{Binding Filter.Plate,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Propietario"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <TextBox Width="180"
                         Margin="10,0"
                         Text="{Binding Filter.OwnerName,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <CheckBox Content="Mensuales"
                          Margin="20,0"
                          Foreground="White"
                          IsChecked="{Binding Filter.IncludeMonthly}"/>

                <CheckBox Content="Ocasionales"
                          Margin="10,0"
                          Foreground="White"
                          IsChecked="{Binding Filter.IncludeOccasional}"/>

                <Button Content="Buscar"
                        Width="120"
                        Margin="20,0"
                        Command="{Binding SearchCommand}"/>

            </StackPanel>

        </Border>

        <!-- REPORTE -->

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

            <Border Width="1122"
                    Height="1587"
                    Background="White"
                    HorizontalAlignment="Center"
                    Margin="20"
                    Padding="50">

                <StackPanel>

                    <!-- TITULO -->

                    <TextBlock Text="REPORTE DE VEHÍCULOS"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Sistema de Parqueadero"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,5"/>

                    <Separator Margin="0,20"/>

                    <!-- FILTROS APLICADOS -->

                    <Grid Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Placa"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Filter.Plate}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Propietario"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Filter.OwnerName}"/>

                        </StackPanel>

                    </Grid>

                    <!-- TABLA -->

                    <DataGrid ItemsSource="{Binding Vehicles}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Height="1200">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Placa"
                                Binding="{Binding Plate}"
                                Width="120"/>

                            <DataGridTextColumn
                                Header="Propietario"
                                Binding="{Binding OwnerName}"
                                Width="220"/>

                            <DataGridTextColumn
                                Header="Tipo"
                                Binding="{Binding VehicleType}"
                                Width="120"/>

                            <DataGridTextColumn
                                Header="Categoría"
                                Binding="{Binding Category}"
                                Width="120"/>

                            <DataGridTextColumn
                                Header="Estado Plan"
                                Binding="{Binding PlanStatus}"
                                Width="120"/>

                            <DataGridTextColumn
                                Header="Mensualidad"
                                Binding="{Binding MonthlyFee,
                                                  StringFormat=C}"
                                Width="130"/>

                            <DataGridTextColumn
                                Header="Ingresos"
                                Binding="{Binding TotalEntries}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Último Ingreso"
                                Binding="{Binding LastEntryDate,
                                                  StringFormat=dd/MM/yyyy HH:mm}"
                                Width="180"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- FOOTER -->

                    <Border BorderBrush="#444"
                            BorderThickness="1"
                            Margin="0,20,0,0"
                            Padding="15">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <TextBlock Text="TOTAL VEHÍCULOS:"
                                       FontWeight="Bold"
                                       FontSize="18"/>

                            <TextBlock Text="{Binding Vehicles.Count}"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="15,0,0,0"/>

                        </StackPanel>

                    </Border>

                    <TextBlock Text="Generado automáticamente por el sistema"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"
                               FontStyle="Italic"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</UserControl>