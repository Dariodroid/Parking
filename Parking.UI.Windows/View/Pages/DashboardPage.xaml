<UserControl x:Class="Parking.UI.Windows.View.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#121212">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- RESUMEN SUPERIOR -->

        <UniformGrid Grid.Row="0"
                     Columns="3">

            <!-- TOTAL -->

            <Border Margin="5"
                    Background="#1E1E1E"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="TOTAL DE PUESTOS"
                               Foreground="#9E9E9E"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding TotalSlots}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- OCUPADOS -->

            <Border Margin="5"
                    Background="#B71C1C"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="PUESTOS OCUPADOS"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding OccupiedSlots}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- LIBRES -->

            <Border Margin="5"
                    Background="#1B5E20"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="PUESTOS LIBRES"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding FreeSlots}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- CONTENIDO -->

        <Grid Grid.Row="1"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL MAPA -->

            <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Background="#1A1A1A"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->

                    <Border Background="#202020"
                            BorderBrush="#333333"
                            BorderThickness="0,0,0,1">

                        <DockPanel Margin="15,0">

                            <TextBlock Text="MAPA DEL PARQUEADERO"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="16"/>

                        </DockPanel>

                    </Border>

                    <!-- TARJETAS -->

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Slots}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <WrapPanel Margin="10"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Command="{Binding DataContext.SelectSlotCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="5"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand">

                                        <Border Width="130"
                                                Height="95"
                                                CornerRadius="10"
                                                BorderThickness="1">

                                            <Border.Style>

                                                <Style TargetType="Border">

                                                    <Setter Property="Background"
                                                            Value="#1B5E20"/>

                                                    <Setter Property="BorderBrush"
                                                            Value="#2E7D32"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsOccupied}"
                                                                     Value="True">

                                                            <Setter Property="Background"
                                                                    Value="#8E2424"/>

                                                            <Setter Property="BorderBrush"
                                                                    Value="#C62828"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Border.Style>

                                            <StackPanel VerticalAlignment="Center">

                                                <TextBlock Text="{Binding SlotNumber}"
                                                           HorizontalAlignment="Center"
                                                           Foreground="White"
                                                           FontSize="24"
                                                           FontWeight="Bold"/>

                                                <TextBlock HorizontalAlignment="Center"
                                                           Margin="0,5,0,0"
                                                           Foreground="White"
                                                           FontWeight="SemiBold">

                                                    <TextBlock.Style>

                                                        <Style TargetType="TextBlock">

                                                            <Setter Property="Text"
                                                                    Value="LIBRE"/>

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding IsOccupied}"
                                                                             Value="True">

                                                                    <Setter Property="Text"
                                                                            Value="OCUPADO"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </TextBlock.Style>

                                                </TextBlock>

                                            </StackPanel>

                                        </Border>

                                    </Button>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

            <!-- PANEL DETALLE -->

            <Border Grid.Column="1"
                    Background="#1E1E1E"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="DETALLE DEL PUESTO"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <Border Background="#252525"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="PUESTO"
                                       Foreground="#9E9E9E"/>

                            <TextBlock Text="{Binding SelectedSlot.SlotNumber}"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#252525"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="PLACA"
                                       Foreground="#9E9E9E"/>

                            <TextBlock Text="{Binding SelectedSlot.Plate}"
                                       Foreground="White"
                                       FontSize="16"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#252525"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="PROPIETARIO"
                                       Foreground="#9E9E9E"/>

                            <TextBlock Text="{Binding SelectedSlot.OwnerName}"
                                       Foreground="White"
                                       FontSize="16"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#252525"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="TIPO DE VEHÍCULO"
                                       Foreground="#9E9E9E"/>

                            <TextBlock Text="{Binding SelectedSlot.VehicleType}"
                                       Foreground="White"
                                       FontSize="16"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#252525"
                            CornerRadius="8"
                            Padding="12">

                        <StackPanel>

                            <TextBlock Text="HORA DE INGRESO"
                                       Foreground="#9E9E9E"/>

                            <TextBlock Text="{Binding SelectedSlot.EntryTime,
                                                      StringFormat=dd/MM/yyyy HH:mm}"
                                       Foreground="White"
                                       FontSize="16"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>