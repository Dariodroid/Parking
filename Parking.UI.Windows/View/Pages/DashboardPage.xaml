<UserControl x:Class="Parking.UI.Windows.View.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="800"
             Background="{DynamicResource AppPageBrush}">

    <Grid Margin="15"
          MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
          MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- RESUMEN SUPERIOR -->
        <UniformGrid Grid.Row="0" Columns="3">
            <Border Margin="5" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="TOTAL DE PUESTOS" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalSlots}" Foreground="{DynamicResource AppTextBrush}" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="5" Background="#B71C1C" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="PUESTOS OCUPADOS" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding OccupiedSlots}" Foreground="White" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Margin="5" Background="#1B5E20" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="PUESTOS LIBRES" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FreeSlots}" Foreground="White" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL MAPA -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER CON BOTÓN DE RESTABLECER -->
                    <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel Margin="15,0">

                            <Button DockPanel.Dock="Right"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding ResetLayoutCommand}"
                                    ToolTip="Restaura la cuadrícula original de los puestos">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="RootBorder"
                                                Background="{DynamicResource AppRaisedBrush}"
                                                BorderBrush="{DynamicResource AppInputBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,6">
                                            <TextBlock Text="⟲ RESTABLECER ORDEN"
                                                       Foreground="{DynamicResource AppTextBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource AppRaisedBrush}"/>
                                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="RootBorder" Property="Background" Value="#1B5E20"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock Text="MAPA DEL PARQUEADERO" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" FontWeight="Bold" FontSize="16"/>
                        </DockPanel>
                    </Border>

                    <!-- TARJETAS CON CANVAS -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Slots}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 🟢 CAMBIOS: Margin="0" ensancha el área útil.
                                         Width/Height dinámicos = tamaño real del contenido.
                                         MinWidth/MinHeight = llenan el panel si hay pocas tarjetas. -->
                                    <Canvas Margin="0"
                                            Width="{Binding MapWidth}"
                                            Height="{Binding MapHeight}"
                                            MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                            MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                            Background="Transparent"
                                            AllowDrop="True"
                                            Drop="Canvas_Drop"
                                            DragEnter="Canvas_DragEnter"
                                            DragLeave="Canvas_DragLeave"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Canvas.Left" Value="{Binding PositionX}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding PositionY}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="160" Height="100"
                                            Padding="0" Margin="0" Cursor="Hand"
                                            AllowDrop="True"
                                            Drop="Slot_Drop"
                                            DragEnter="Slot_DragEnter"
                                            DragLeave="Slot_DragLeave"
                                            Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">

                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter Content="{TemplateBinding Content}"/>
                                            </ControlTemplate>
                                        </Button.Template>

                                        <Border CornerRadius="12" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1B5E20"/>
                                                    <Setter Property="BorderBrush" Value="#2E7D32"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                            <Setter Property="Background" Value="#8E2424"/>
                                                            <Setter Property="BorderBrush" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SlotNumber}" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="LIBRE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                                    <Setter Property="Text" Value="OCUPADO"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- PANEL DETALLE -->
            <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="DETALLE DEL PUESTO" Foreground="{DynamicResource AppTextBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border Background="{DynamicResource AppRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PUESTO" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock Text="{Binding SelectedSlot.SlotNumber}" Foreground="{DynamicResource AppTextBrush}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PLACA" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock Text="{Binding SelectedSlot.Plate}" Foreground="{DynamicResource AppTextBrush}" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PROPIETARIO" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock Text="{Binding SelectedSlot.OwnerName}" Foreground="{DynamicResource AppTextBrush}" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="TIPO DE VEHÍCULO" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock Text="{Binding SelectedSlot.VehicleType}" Foreground="{DynamicResource AppTextBrush}" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppRaisedBrush}" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="HORA DE INGRESO" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock Text="{Binding SelectedSlot.EntryTime, StringFormat=dd/MM/yyyy HH:mm}" Foreground="{DynamicResource AppTextBrush}" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="POSICIÓN (X, Y)" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="X: " Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding SelectedSlot.PositionX}" Foreground="{DynamicResource AppTextBrush}" FontSize="10"/>
                                <TextBlock Text="  Y: " Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding SelectedSlot.PositionY}" Foreground="{DynamicResource AppTextBrush}" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
