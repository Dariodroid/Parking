<UserControl x:Class="Parking.UI.Windows.View.Pages.UserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Parking.UI.Windows.Converters"
             mc:Ignorable="d"
             Background="#121212"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <UserControl.Resources>

        <conv:BooleanToCheckConverter x:Key="BooleanToCheckConverter"/>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinWidth" Value="95"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>

                        <TextBlock Text="USUARIOS"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="USUARIO" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="NOMBRE COMPLETO" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="ROL" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="CONTRASEÑA" Style="{StaticResource LabelStyle}"/>
                        <PasswordBox x:Name="PasswordBox"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Style="{StaticResource PasswordStyle}"/>

                        <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource LabelStyle}"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                     Style="{StaticResource PasswordStyle}"/>

                        <TextBlock Text="ESTADO"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,4,0,6"/>

                        <ToggleButton IsChecked="{Binding IsActive, Mode=TwoWay}"
                                      Width="150"
                                      Height="36"
                                      HorizontalAlignment="Left"
                                      Cursor="Hand"
                                      BorderThickness="0"
                                      Focusable="False">

                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Grid Width="150" Height="36">

                                            <Border x:Name="SwitchBackground"
                                                    CornerRadius="18"
                                                    Background="#2E7D32"/>

                                            <TextBlock x:Name="SwitchText"
                                                       Text="ACTIVO"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>

                                            <Border x:Name="Knob"
                                                    Width="28"
                                                    Height="28"
                                                    CornerRadius="14"
                                                    Background="White"
                                                    HorizontalAlignment="Right"
                                                    Margin="4"/>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="SwitchBackground" Property="Background" Value="#666666"/>
                                            <Setter TargetName="SwitchText" Property="Text" Value="INACTIVO"/>
                                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Left"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>

                        </ToggleButton>

                    </StackPanel>
                </Border>

                <!-- BOTONES -->
                <Border Style="{StaticResource SectionStyle}">
                    <WrapPanel>

                        <Button Content="GUARDAR"
                                Command="{Binding SaveCommand}"
                                Background="#2E7D32"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="ACTUALIZAR"
                                Command="{Binding UpdateCommand}"
                                Background="#1565C0"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="NUEVO"
                                Command="{Binding NewCommand}"
                                Background="#333333"
                                Foreground="#DDDDDD"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <Button Content="ELIMINAR"
                                Command="{Binding DeleteCommand}"
                                Background="#C62828"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"/>

                    </WrapPanel>
                </Border>

                <!-- ESTADO -->
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="ESTADO"
                                   Foreground="#888888"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#CCCCCC"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- TABLA -->
        <Border Grid.Column="2"
                Background="#1A1A1A"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">

            <DataGrid ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      Background="#1A1A1A"
                      Foreground="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowBackground="#1A1A1A"
                      AlternatingRowBackground="#202020"
                      CanUserAddRows="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Usuario"
                                        Binding="{Binding username}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding full_name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Rol"
                                        Binding="{Binding role}"
                                        Width="100"/>

                    <DataGridTemplateColumn Header="Activo"
                                            Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="White"
                                           Text="{Binding is_active, Converter={StaticResource BooleanToCheckConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>
</UserControl>