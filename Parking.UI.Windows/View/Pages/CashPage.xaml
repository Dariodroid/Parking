<UserControl x:Class="Parking.UI.Windows.View.Pages.CashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#121212">

    <UserControl.Resources>

        <!-- ESTILOS DEL PROYECTO -->

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="MinWidth" Value="95"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="DarkDataGridHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#2A2A2A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#444444"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

        </Style>

    </UserControl.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MÉTRICAS -->

        <UniformGrid Grid.Row="0"
                     Rows="1"
                     Columns="4">

            <Border Margin="5"
                    Background="#1E1E1E"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="INGRESOS HOY"
                               Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding TodayIncome,StringFormat=C}"
                               Foreground="#10B981"
                               FontWeight="Bold"
                               FontSize="26"/>

                </StackPanel>

            </Border>

            <Border Margin="5"
                    Background="#1E1E1E"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="INGRESOS MES"
                               Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding MonthIncome,StringFormat=C}"
                               Foreground="#60A5FA"
                               FontWeight="Bold"
                               FontSize="26"/>

                </StackPanel>

            </Border>

            <Border Margin="5"
                    Background="#1E1E1E"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="EFECTIVO"
                               Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding CashIncome,StringFormat=C}"
                               Foreground="#FBBF24"
                               FontWeight="Bold"
                               FontSize="26"/>

                </StackPanel>

            </Border>

            <Border Margin="5"
                    Background="#1E1E1E"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="TOTAL COBROS"
                               Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding TotalPayments}"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="26"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- FILTROS -->

        <Border Grid.Row="1"
                Style="{StaticResource SectionStyle}"
                Margin="5">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="DESDE"
                           Style="{StaticResource LabelStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <DatePicker Width="140"
                            SelectedDate="{Binding FromDate}"/>

                <TextBlock Text="HASTA"
                           Style="{StaticResource LabelStyle}"
                           VerticalAlignment="Center"
                           Margin="20,0,10,0"/>

                <DatePicker Width="140"
                            SelectedDate="{Binding ToDate}"/>

                <Button Content="ACTUALIZAR"
                        Command="{Binding RefreshCommand}"
                        Background="#1565C0"
                        Foreground="White"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="20,0,0,0"/>
                <Button Content="EXPORTAR EXCEL"
                        Command="{Binding ExportExcelCommand}"
                        Background="#2E7D32"
                        Foreground="White"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="10,0,0,0"/>

            </StackPanel>

        </Border>

        <!-- TABLA -->

        <Border Grid.Row="2"
                Margin="5"
                Background="#1A1A1A"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6">

            <DataGrid ItemsSource="{Binding Payments}"
          AutoGenerateColumns="False"
          Background="#1A1A1A"
          Foreground="White"
          BorderThickness="0"
          GridLinesVisibility="Horizontal"
          HeadersVisibility="Column"
          RowBackground="#1A1A1A"
          AlternatingRowBackground="#202020"
          CanUserAddRows="False"
          IsReadOnly="True"
          ColumnHeaderStyle="{StaticResource DarkDataGridHeaderStyle}"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="PLACA"
                            Binding="{Binding session.plate}"
                            Width="120"/>

                    <DataGridTextColumn Header="OPERADOR"
                            Binding="{Binding collected_byNavigation.full_name}"
                            Width="220"/>

                    <DataGridTextColumn Header="MONTO"
                            Binding="{Binding amount_paid,StringFormat={}{0:N2}}"
                            Width="120"/>

                    <DataGridTextColumn Header="MÉTODO"
                            Binding="{Binding payment_method}"
                            Width="120"/>

                    <DataGridTextColumn Header="REFERENCIA"
                            Binding="{Binding payment_reference}"
                            Width="180"/>

                    <DataGridTextColumn Header="FECHA COBRO"
                            Binding="{Binding collected_at,StringFormat=dd/MM/yyyy HH:mm}"
                            Width="170"/>

                    <DataGridTextColumn Header="OBSERVACIÓN"
                            Binding="{Binding notes}"
                            Width="300"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>