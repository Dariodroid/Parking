<UserControl x:Class="Parking.UI.Windows.View.Pages.CashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="{DynamicResource AppPageBrush}"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ESTILOS DEL PROYECTO -->

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="MinWidth" Value="95"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="DarkDataGridHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="{DynamicResource AppRaisedBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource AppInputBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

        </Style>

    </UserControl.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MÉTRICAS -->

        <UniformGrid Grid.Row="0"
                     Rows="1"
                     Columns="4">

            <Border Margin="5"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="INGRESOS HOY"
                               Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding TodayIncome,StringFormat=C}"
                               Foreground="#10B981"
                               FontWeight="Bold"
                               FontSize="26"/>

                </StackPanel>

            </Border>

            <Border Margin="5"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">

                <StackPanel>

                    <!-- La tarjeta suma el rango consultado, no necesariamente el mes calendario. -->
                    <TextBlock Text="TOTAL DEL PERÍODO"
                               Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding MonthIncome,StringFormat=C}"
                               Foreground="#60A5FA"
                               FontWeight="Bold"
                               FontSize="26"/>

                </StackPanel>

            </Border>

            <Border Margin="5"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="EFECTIVO"
                               Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding CashIncome,StringFormat=C}"
                               Foreground="#FBBF24"
                               FontWeight="Bold"
                               FontSize="26"/>

                </StackPanel>

            </Border>

            <Border Margin="5"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="TOTAL COBROS"
                               Foreground="#9CA3AF"/>

                    <TextBlock Text="{Binding TotalPayments}"
                               Foreground="{DynamicResource AppTextBrush}"
                               FontWeight="Bold"
                               FontSize="26"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- FILTROS -->

        <Border Grid.Row="1"
                Style="{StaticResource SectionStyle}"
                Margin="5">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="DESDE"
                           Style="{StaticResource LabelStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <!-- DATEPICKER DESDE CON TEXTO BLANCO -->
                <DatePicker Width="140"
                            SelectedDate="{Binding FromDate}"
                            Foreground="{DynamicResource AppTextBrush}"
                            Background="{DynamicResource AppInputBrush}">

                    <DatePicker.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"
                            Color="White"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"
                            Color="White"/>

                        <Style TargetType="{x:Type DatePickerTextBox}">
                            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}"/>
                        </Style>
                    </DatePicker.Resources>

                </DatePicker>

                <TextBlock Text="HASTA"
                           Style="{StaticResource LabelStyle}"
                           VerticalAlignment="Center"
                           Margin="20,0,10,0"/>

                <!-- DATEPICKER HASTA CON TEXTO BLANCO -->
                <DatePicker Width="140"
                            SelectedDate="{Binding ToDate}"
                            Foreground="{DynamicResource AppTextBrush}"
                            Background="{DynamicResource AppInputBrush}">

                    <DatePicker.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"
                            Color="White"/>

                        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"
                            Color="White"/>

                        <Style TargetType="{x:Type DatePickerTextBox}">
                            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}"/>
                        </Style>
                    </DatePicker.Resources>

                </DatePicker>

                <Button Command="{Binding RefreshCommand}"
                        Background="#1565C0"
                        Foreground="White"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DatabaseRefresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ACTUALIZAR" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ExportExcelCommand}"
                        Background="#2E7D32"
                        Foreground="White"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="EXPORTAR EXCEL" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>

        </Border>

        <!-- TABLA -->

        <Border Grid.Row="2"
                Margin="5"
                Background="{DynamicResource AppSidebarBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6">

            <DataGrid ItemsSource="{Binding Payments}"
          AutoGenerateColumns="False"
          Background="{DynamicResource AppSidebarBrush}"
          Foreground="{DynamicResource AppTextBrush}"
          BorderThickness="0"
          GridLinesVisibility="Horizontal"
          HeadersVisibility="Column"
          RowBackground="{DynamicResource AppSidebarBrush}"
          AlternatingRowBackground="{DynamicResource AppSurfaceBrush}"
          CanUserAddRows="False"
          IsReadOnly="True"
          ColumnHeaderStyle="{StaticResource DarkDataGridHeaderStyle}"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="PLACA"
                            Binding="{Binding session.plate}"
                            Width="120"/>

                    <DataGridTextColumn Header="OPERADOR"
                            Binding="{Binding collected_byNavigation.full_name}"
                            Width="220"/>

                    <DataGridTextColumn Header="MONTO"
                            Binding="{Binding amount_paid,StringFormat={}{0:N2}}"
                            Width="120"/>

                    <DataGridTextColumn Header="MÉTODO"
                            Binding="{Binding payment_method}"
                            Width="120"/>

                    <DataGridTextColumn Header="REFERENCIA"
                            Binding="{Binding payment_reference}"
                            Width="180"/>

                    <DataGridTextColumn Header="FECHA COBRO"
                            Binding="{Binding collected_at,StringFormat=dd/MM/yyyy HH:mm}"
                            Width="170"/>

                    <DataGridTextColumn Header="OBSERVACIÓN"
                            Binding="{Binding notes}"
                            Width="300"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>
