<Window x:Class="Parking.UI.Windows.View.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="450"
             Height="560"
             mc:Ignorable="d"
             Background="#121212">


    <Window.Resources>


        <Style x:Key="SectionStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#1E1E1E"/>

            <Setter Property="BorderBrush"
                    Value="#333333"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="4"/>

            <Setter Property="Padding"
                    Value="20"/>

        </Style>


        <Style x:Key="LabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#AAAAAA"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,0,0,4"/>

        </Style>


        <Style x:Key="InputStyle"
               TargetType="TextBox">


            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Background"
                    Value="#0A0A0A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#444444"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="8,4"/>

            <Setter Property="Margin"
                    Value="0,0,0,10"/>

        </Style>



        <Style x:Key="PasswordStyle"
               TargetType="PasswordBox">


            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Background"
                    Value="#0A0A0A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#444444"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="8,4"/>

            <Setter Property="Margin"
                    Value="0,0,0,10"/>

        </Style>



        <Style x:Key="ButtonStyle"
               TargetType="Button">


            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Background"
                    Value="#1565C0"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>


    </Window.Resources>



    <Grid>


        <Border Width="430"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource SectionStyle}">


            <StackPanel>


                <!-- Icono -->
                <TextBlock Text="🚗"
                           FontSize="60"
                           HorizontalAlignment="Center"/>



                <!-- Titulo -->
                <TextBlock Text="SISTEMA DE PARQUEO"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,5"/>



                <TextBlock Text="CONTROL DE ACCESO"
                           Foreground="#999999"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>



                <!-- Usuario -->

                <TextBlock Text="USUARIO"
                           Style="{StaticResource LabelStyle}"/>


                <TextBox
                    Text="{Binding Username,
                           UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource InputStyle}"/>



                <!-- Contraseña -->

                <TextBlock Text="CONTRASEÑA"
                           Style="{StaticResource LabelStyle}"/>


                <PasswordBox
                    x:Name="PasswordBox"
                    Style="{StaticResource PasswordStyle}"
                    PasswordChanged="PasswordBox_PasswordChanged"/>



                <!-- Error -->

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#EF5350"
                           FontSize="12"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,10"/>



                <!-- Recordar -->

                <CheckBox Content="Mantener sesión iniciada"
                          Foreground="#BBBBBB"
                          FontSize="12"
                          Margin="0,0,0,15"
                          IsChecked="{Binding RememberMe}"/>



                <!-- Login -->

                <Button Content="INGRESAR AL SISTEMA"
                        Style="{StaticResource ButtonStyle}"
                        Command="{Binding LoginCommand}"/>



                <!-- Separador -->

                <Border Height="1"
                        Background="#333333"
                        Margin="0,25,0,15"/>



                <TextBlock Text="Sistema de Gestión de Parqueo"
                           Foreground="#777777"
                           FontSize="11"
                           HorizontalAlignment="Center"/>



                <TextBlock Text="GAD Municipal del Cantón Palanda"
                           Foreground="#555555"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>


            </StackPanel>


        </Border>


    </Grid>


</Window>