<Window x:Class="Parking.UI.Windows.View.Dialogs.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#88000000"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Border Background="#88000000" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"/>

        <Border Width="420"
                Background="#1E1E1E"
                CornerRadius="10"
                BorderBrush="#333333"
                BorderThickness="1"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO E ICONO -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock x:Name="IconText" Text="ℹ️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Text="Información" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- MENSAJE -->
                <TextBlock x:Name="MessageText"
                           Grid.Row="1"
                           Margin="0,0,0,25"
                           Foreground="#DDDDDD"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           LineHeight="20"/>

                <!-- CONTENEDOR DE BOTONES -->
                <StackPanel x:Name="ButtonsPanel" 
                            Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">

                    <!-- Botón OK (Verde) -->
                    <Button x:Name="BtnOK" Content="Aceptar" Width="100" Height="36" Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="BtnOK_Click"/>

                    <!-- Botón Sí (Azul) -->
                    <Button x:Name="BtnYes" Content="Sí" Width="100" Height="36" Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Visibility="Collapsed" Click="BtnYes_Click"/>

                    <!-- Botón No (Gris) -->
                    <Button x:Name="BtnNo" Content="No" Width="100" Height="36" Background="#424242" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Visibility="Collapsed" Click="BtnNo_Click"/>

                    <!-- Botón Cancelar (Gris oscuro) -->
                    <Button x:Name="BtnCancel" Content="Cancelar" Width="100" Height="36" Background="#424242" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Visibility="Collapsed" Click="BtnCancel_Click"/>

                    <!-- 🟢 NUEVO: Botón Eliminar (Rojo con icono) -->
                    <Button x:Name="BtnDelete" Content="🗑️ Eliminar" Width="120" Height="36" Background="#C62828" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" Visibility="Collapsed" Click="BtnDelete_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#B71C1C"/>
                                        <!-- Se oscurece un poco al pasar el mouse -->
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>