<Window x:Class="Parking.UI.Windows.View.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#88000000"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid>

        <!-- FONDO OSCURO -->
        <Border Background="#88000000"/>

        <!-- MODAL -->
        <Border Width="420"
                Height="220"
                Background="#1E1E1E"
                CornerRadius="10"
                BorderBrush="#333333"
                BorderThickness="1"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Confirmar eliminación"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"/>

                <TextBlock Grid.Row="1"
                           x:Name="MessageText"
                           Margin="0,20,0,0"
                           Foreground="#DDDDDD"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="Cancelar"
                            Width="100"
                            Height="36"
                            Margin="0,0,10,0"
                            Background="#333333"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Cancel_Click"/>

                    <Button Content="Eliminar"
                            Width="100"
                            Height="36"
                            Background="#C62828"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Confirm_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>