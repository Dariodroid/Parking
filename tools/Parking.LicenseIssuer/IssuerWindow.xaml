<Window x:Class="Parking.LicenseIssuer.IssuerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emitir licencia de Parking" Width="690" Height="570"
        MinWidth="610" MinHeight="500" WindowStartupLocation="CenterScreen"
        Background="#F3F6FA">
    <Border Margin="18" Padding="22" Background="White" CornerRadius="10"
            BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="GENERAR SERIAL" FontSize="23" FontWeight="Bold" Foreground="#18324A"/>
                <TextBlock Text="Escriba el código que le envió el cliente y elija cuánto tiempo funcionará."
                           Margin="0,5,0,0" Foreground="#526579" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="CLIENTE" FontWeight="SemiBold" Foreground="#43556A"/>
                <TextBox x:Name="CustomerInput" Height="34" Margin="0,4,0,0" MaxLength="120"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="CÓDIGO DEL EQUIPO" FontWeight="SemiBold" Foreground="#43556A"/>
                <TextBox x:Name="CodeInput" Height="34" Margin="0,4,0,0" MaxLength="32"
                         CharacterCasing="Upper"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DURACIÓN" FontWeight="SemiBold" Foreground="#43556A"/>
                    <ComboBox x:Name="TermInput" Height="34" Margin="0,4,0,0" SelectedIndex="3"
                              SelectionChanged="TermInput_SelectionChanged">
                        <ComboBoxItem Content="1 mes" Tag="1"/>
                        <ComboBoxItem Content="3 meses" Tag="3"/>
                        <ComboBoxItem Content="6 meses" Tag="6"/>
                        <ComboBoxItem Content="12 meses" Tag="12"/>
                        <ComboBoxItem Content="Hasta una fecha" Tag="date"/>
                        <ComboBoxItem Content="Sin vencimiento" Tag="life"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="FECHA FINAL (SI APLICA)" FontWeight="SemiBold" Foreground="#43556A"/>
                    <DatePicker x:Name="CustomDateInput" Height="34" Margin="0,4,0,0" IsEnabled="False"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="TU CLAVE PRIVADA" FontWeight="SemiBold" Foreground="#43556A"/>
                    <TextBox x:Name="PrivateKeyInput" Height="34" Margin="0,4,8,0" IsReadOnly="True"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Buscar..." Width="90" Height="34" Margin="0,20,0,0"
                        Click="BrowseKey_Click"/>
            </Grid>

            <Grid Grid.Row="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Content="GENERAR SERIAL" Height="39" Background="#1565C0" Foreground="White"
                        FontWeight="Bold" Click="Generate_Click"/>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SERIAL PARA ENVIAR AL CLIENTE" FontWeight="SemiBold" Foreground="#43556A"/>
                    <TextBox x:Name="SerialOutput" Grid.Row="1" Margin="0,4,0,0" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="6" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="#285C29"/>
                <Button Grid.Column="1" Content="Guardar archivo" Width="120" Height="34"
                        Margin="8,0,8,0" Click="Save_Click"/>
                <Button Grid.Column="2" Content="Copiar serial" Width="115" Height="34"
                        Click="Copy_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
